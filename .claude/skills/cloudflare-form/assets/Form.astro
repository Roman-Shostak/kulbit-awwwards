---
/**
 * Form — the shell of every form that submits to the site's Worker (worker/index.ts, `POST /api/form`): the
 * hidden `form` and `locale` fields, the honeypot, the fill-time field, the status message, the success block and
 * the script. The fields, texts and the submit button come from the section (slot); the state texts come from the
 * `form` dictionary and reach the script as `data-*`. States set by src/scripts/form.ts: `is--sending` on the form,
 * `is--visible` on the message, `aria-invalid` on the fields that failed the check; on success the form fades out
 * (`is--sent`) and is replaced by the success block — a brand Card with a tick, a title and a sentence — that fades in
 * (`keepHeight` keeps the form's height so the section layout does not jump).
 * No success state in Figma: the block is composed from the Card, the tick icon and the text styles.
 * Without JS the browser validates `required` and the Worker answers with a plain page.
 */
import type { HTMLAttributes } from 'astro/types';
import TickIcon from '@/assets/icons/tick.svg';
import Card from '@/components/ui/Card.astro';
import { toLocale, useTranslations } from '@/i18n';

interface Props extends HTMLAttributes<'form'> {
  /** `data-form`: names the form in D1 */
  name: string;
  /** The success block keeps the form's height, so a section whose layout depends on it (a photo as tall as the
   * column) does not jump; off in a popup, where the panel should shrink to the block */
  keepHeight?: boolean;
}

const { name, keepHeight = false, class: className, ...rest } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale).form;
---

<form
  method="post"
  action="/api/form"
  class={className}
  data-form={name}
  data-sending={t.sending}
  data-error={t.error}
  data-error-required={t.errorRequired}
  data-error-contact={t.errorContact}
  data-error-email={t.errorEmail}
  data-error-phone={t.errorPhone}
  data-error-rate={t.errorRate}
  {...rest}
>
  <input type="hidden" name="form" value={name} />
  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="started" value="" />
  {/* Honeypot: off screen, out of the tab order and of the accessibility tree; a bot fills it and the Worker drops the submission */}
  <label class="form_trap" aria-hidden="true">Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  <slot />
  <p class="form_message text-size-caption" role="status" hidden data-form-message></p>
</form>
{/* Takes the form's place after a successful submit; a plain wrapper carries `hidden` (the Card's own display would override it) */}
<div class="form-success" role="status" hidden data-form-success data-form-keep-height={keepHeight ? '' : undefined}>
  <Card type="brand" size="lg" class="form-success_card spacing-md align-start">
    <span class="form-success_icon"><TickIcon class="form-success_tick" aria-hidden="true" /></span>
    <p class="text-size-h4 text-weight-600">{t.successTitle}</p>
    <p class="text-size-body-md">{t.success}</p>
  </Card>
</div>

<script>
  import '@/scripts/form';
</script>

<style>
  .form_trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }
  .form_message {
    opacity: 0;
    transition: opacity var(--transition-duration) var(--transition-easing);
  }
  .form_message.is--visible {
    opacity: 1;
  }
  /* Sent: the form fades out, the script hides it when the transition has finished and shows the success block */
  form[data-form] {
    transition: opacity var(--transition-duration) var(--transition-easing);
  }
  form[data-form].is--sent {
    opacity: 0;
  }
  /* The section's `flex-v` (display: flex) would beat the UA `[hidden]`; scoped rules are unlayered and win */
  form[data-form][hidden] {
    display: none;
  }
  .form-success {
    opacity: 0;
    transform: translateY(var(--size-16));
    transition:
      opacity var(--transition-duration-slow) var(--transition-easing),
      transform var(--transition-duration-slow) var(--transition-easing);
  }
  .form-success.is--visible {
    opacity: 1;
    transform: none;
  }
  /* keepHeight: the script measures the form before it goes and writes `--form-height` on the wrapper */
  [data-form-keep-height] .form-success_card {
    min-height: var(--form-height, auto);
    justify-content: center;
  }
  /* The tick in a 48 px contrast circle (bg/card/small-contrast, like the number badges) */
  .form-success_icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size-48);
    height: var(--size-48);
    border-radius: var(--radius-full);
    background-color: var(--theme-card-bg-small-contrast);
    color: var(--theme-text-brand);
  }
  .form-success_tick {
    width: var(--size-24);
    height: var(--size-24);
  }
</style>
