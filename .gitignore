# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# editors
.idea/

# Claude Code: personal, machine-local settings
.claude/settings.local.json

# Claude Code: personal project notes (loaded after CLAUDE.md, not shared)
CLAUDE.local.md

# generated OG images (built from src/assets/og by scripts/build-og.mjs)
public/og/

# screenshots and measurements from `pnpm shot` (scripts/screenshot.mjs)
screenshots/

# Worker secrets for `pnpm worker` (wrangler dev)
.dev.vars*

# wrangler: local D1 data and cache
.wrangler/
# generated by `pnpm worker:types` (part of `pnpm check`)
worker/worker-configuration.d.ts

# The Webflow export the sections are ported from (reference only, 34 MB)
/WEBFLOW/

# Client video masters: sources for public/video (encoded with ffmpeg), never committed
video-masters/
