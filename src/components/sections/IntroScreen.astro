---
/**
 * IntroScreen — the screen that opens a topic before its section: before the working process («Working process») and
 * before the traditional production comparison («Traditional Production / vs kulbit»). Built from the Webflow build
 * (kulbit-gsap export, the sections with «.flex-h-v-v.is-working-process-screen»: the same markup and classes both
 * times, only the texts differ); values 1:1 from its CSS (1rem = 16px on the 1920 / 744 / 390 frames = our fluid
 * scale).
 *
 * The full progress line, the label (written by scramble when the section enters the screen, data-kulbit-scramble;
 * `accent` = its blue part), the statement (typed letter by letter, data-kulbit-typewriter) and the pilot button
 * (Button «second», the hover border from the cursor: data-kulbit-border). No steps of its own: one gesture moves to
 * the next section. The label is the <h2> of the topic: the section after the screen continues its outline.
 * The page passes the texts of one dictionary key (workingProcessIntro, traditionalProductionIntro) and the `id` of the
 * screen (the anchor the menu links to).
 */
import Button from '@/components/ui/Button.astro';
import ProgressLine from '@/components/ui/ProgressLine.astro';

interface Props {
  /** The anchor of the screen (SectionNav links to it) */
  id?: string;
  title: string;
  accent?: string;
  /** One sentence; the grey parts as on the site */
  statement: { text: string; grey: boolean }[];
  pilot: string;
}

const { id, title, accent, statement, pilot } = Astro.props;
---

<section class="section padding-md" id={id} data-kulbit-section>
  <div class="container">
    <div class="flex-v spacing-2xl text-style-uppercase">
      <ProgressLine start="full" />
      <div class="intro-screen_head flex-h/v/v spacing-head">
        <h2 class="text-size-section-label" data-kulbit-scramble>
          {title}{accent && ' '}{accent && <span class="text-color-accent">{accent}</span>}
        </h2>
        <div class="intro-screen_body flex-v spacing-120/160/64">
          <div class="intro-screen_lead">
            <p class="intro-screen_statement text-size-section-h2" data-kulbit-typewriter>
              {
                statement.map((part, i) => (
                  <Fragment>
                    {i > 0 && ' '}
                    {part.grey ? <span class="text-color-secondary">{part.text}</span> : part.text}
                  </Fragment>
                ))
              }
            </p>
          </div>
          <Button variant="second" data-kulbit-border="" data-popup="contact">{pilot}</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .spacing-120\/160\/64 {
    gap: var(--size-120);
  }

  /* .flex-h-v-v.is-working-process-screen */
  .intro-screen_head {
    position: relative;
    align-items: flex-start;
    justify-content: space-between;
  }
  /* .margin-left-auto: the tablet column pushes it to the right (the desktop row does it by space-between) */
  .intro-screen_body {
    margin-left: auto;
  }
  /* .width-695-557-a */
  .intro-screen_lead {
    width: var(--width-statement);
  }
  .intro-screen_statement {
    text-align: justify;
  }

  @media (max-width: 991px) {
    .spacing-120\/160\/64 {
      gap: var(--size-160);
    }
    .intro-screen_head {
      align-items: stretch;
      justify-content: flex-start;
    }
  }

  @media (max-width: 479px) {
    .spacing-120\/160\/64 {
      gap: var(--size-64);
    }
  }
</style>
