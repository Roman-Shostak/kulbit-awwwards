---
/**
 * LandscapePopup — what a phone held sideways shows instead of the site (the Webflow build: .landscape-popup, values
 * 1:1 from its CSS, 1rem = 16px on the 1920 / 744 / 390 frames = our fluid scale): the logo in the corner, the rotate
 * icon, «Explore better experience» and the request to turn the phone, centred on the page background.
 * src/scripts/kulbit/responsive.ts removes `hidden` on `(orientation: landscape) and (max-height: 500px) and
 * (pointer: coarse)`, turns the navigation off and pauses the videos; the engine makes the rest of the page inert and
 * moves the focus onto the dialog (tabindex="-1"). It appears and disappears at once: it follows a rotation of the phone.
 * Rendered in the header slot (<LandscapePopup slot="header" />): .header-fixed has no transform, so the fixed popup
 * covers the whole screen, above the header and the menu panel (z-index 2 inside .header-fixed, which lies over the
 * sections and the footer). The dialog is named by its heading; the logo is the plain mark (a link home would only lead
 * back to this popup). `open` (the /dev/components showcase only): shown in the flow of the page, not fixed, and not
 * modal (aria-modal would hide the rest of the showcase from a screen reader).
 */
import IconRotate from '@/assets/icons/rotate-phone.svg';
import Logo from '@/components/ui/Logo.astro';
import { useTranslations } from '@/i18n';

interface Props {
  open?: boolean;
}

const { open = false } = Astro.props;
const t = useTranslations(Astro.currentLocale).landscapePopup;
---

<div
  class:list={['landscape-popup', { 'type--inline': open }]}
  role="dialog"
  aria-modal={open ? undefined : 'true'}
  aria-labelledby="landscape-popup-title"
  tabindex="-1"
  data-kulbit-landscape-popup
  hidden={!open}>
  <Logo element="span" size="125" class="landscape-popup_logo" />
  <div class="landscape-popup_body text-align-center text-style-uppercase">
    <div class="flex-v align-center spacing-lg">
      <IconRotate class="landscape-popup_icon text-color-secondary" aria-hidden="true" />
      <div class="flex-v align-center spacing-sm">
        <h2 class="text-size-landscape-heading" id="landscape-popup-title">{t.title}</h2>
        <p class="text-size-landscape-paragraph text-weight-700 text-color-secondary">{t.text}</p>
      </div>
    </div>
  </div>
</div>

<style>
  /* .landscape-popup: the whole screen, black, the content in the middle */
  .landscape-popup {
    position: fixed;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--theme-page-bg);
  }
  /* the scoped display must not beat `hidden` */
  .landscape-popup[hidden] {
    display: none;
  }
  /* the panel itself is not interactive: the focus the engine moves onto it needs no ring */
  .landscape-popup:focus-visible {
    outline: none;
  }
  /* /dev/components: in the flow of the page, the proportions of a phone held sideways (844 × 390) */
  .landscape-popup.type--inline {
    position: relative;
    z-index: auto;
    aspect-ratio: 844 / 390;
  }
  /* .logo.is-landscape-popup: 1rem from the top, 1.5rem from the left */
  .landscape-popup_logo {
    position: absolute;
    top: var(--size-16);
    left: var(--size-24);
  }
  /* .width-390 */
  .landscape-popup_body {
    width: calc(24.38rem * var(--fluid-scale));
  }
  /* .icon-48; its colour (#323232 in the Webflow embed: no token) is the paragraph's grey, text-color-secondary */
  .landscape-popup_icon {
    width: var(--size-48);
    height: var(--size-48);
  }
  /* PP Monument Wide Regular 16 / 1.3, tracking 0.01em */
  .text-size-landscape-heading {
    font-family: var(--font-secondary);
    font-size: var(--size-16);
    line-height: 1.3;
    letter-spacing: 0.01em;
  }
  /* Decima Mono X 15 / 1.3 (.94rem) */
  .text-size-landscape-paragraph {
    font-size: calc(0.94rem * var(--fluid-scale));
    line-height: 1.3;
  }
</style>
