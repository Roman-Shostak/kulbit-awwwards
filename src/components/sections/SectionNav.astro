---
/**
 * SectionNav — the quick jump between the screens of the home page: an arrow tab on the right edge of the screen,
 * always there, slides the menu panel in from the right (and back); the panel lists the nine screens with the
 * current one marked (a square + aria-current="location", kept live by the engine's `kulbit:section` event); an item
 * is a link to its screen's anchor (href="#<id>": the plain jump without JS) that the engine takes over — it jumps to
 * the screen at its start (data-target-section → autoAdvanceTo: down over a black backdrop, src/scripts/kulbit/
 * sections.ts; the engine's click handler prevents the native jump) and closes the panel. Under the list the toggle
 * that pauses the autoplaying background videos (WCAG 2.2.2; aria-pressed, the square marks it on; src/scripts/kulbit/
 * video.ts keeps the choice).
 * Rendered in the header slot (<SectionNav slot="header" />): .header-fixed lies over the stacked sections and has no
 * transform, so the fixed panel covers the whole screen height, the header button included.
 * Not in the Webflow build or in Figma: a provisional look in the site's style (the --theme-frame frames, the Decima Mono
 * label, the triangle of the player icons) until the designer's mockup — the values are marked TODO.
 * Disclosure pattern: <nav> > <button aria-expanded aria-controls> (the arrow, named by aria-label) + the panel
 * (inert + aria-hidden while closed). Esc, a click outside and an item close it; Esc and an item bring the focus back
 * to the arrow. The panel slides and the arrow turns on the motion tokens.
 * The items target the screens by index: their order is the order of the page.
 */
import IconTriangle from '@/assets/icons/play-triangle.svg';
import Square from '@/components/ui/Square.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale).sectionNav;
// The ids of the screens, in the order of the page = the order of t.items (Hero, Our Clients … Footer)
const targets = [
  'hero',
  'clients',
  'projects',
  'services',
  'working-process-intro',
  'working-process',
  'traditional-production-intro',
  'traditional-production',
  'footer',
];
---

<nav class="section-nav" aria-label={t.label} data-section-nav>
  <button
    type="button"
    class="section-nav_tab"
    aria-expanded="false"
    aria-controls="section-nav-panel"
    aria-label={t.toggle}
    data-section-nav-toggle>
    <IconTriangle class="section-nav_arrow" aria-hidden="true" />
  </button>
  <div class="section-nav_panel" id="section-nav-panel" inert aria-hidden="true" data-section-nav-panel>
    <div class="text-size-section-label text-weight-700 text-style-uppercase">
      <ul>
        {
          t.items.map((item, i) => (
            <li>
              <a
                href={`#${targets[i]}`}
                class="section-nav_item align-center spacing-xs"
                aria-current={i === 0 ? 'location' : undefined}
                data-target-section={i}>
                <Square size="12" class="section-nav_mark" />
                {item}
              </a>
            </li>
          ))
        }
      </ul>
      {/* TODO: not in the design — the toggle looks like the items until the designer's mockup */}
      <div class="section-nav_extra">
        <button type="button" class="section-nav_item align-center spacing-xs" aria-pressed="false" data-video-pause>
          <Square size="12" class="section-nav_mark" />
          {t.pauseVideo}
        </button>
      </div>
    </div>
  </div>
</nav>

<style>
  /* TODO: not in Figma — every value below is provisional until the designer's mockup */
  /* The panel on the right, the whole screen height; closed = moved out by its own width (the tab stays on the edge) */
  .section-nav {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    width: calc(22.5rem * var(--fluid-scale)); /* 360 */
    transform: translateX(100%);
    transition: transform var(--transition-duration) var(--transition-easing);
  }
  .section-nav.is--open {
    transform: none;
  }
  /* The arrow tab: on the panel's left edge, in the middle of the screen */
  .section-nav_tab {
    position: absolute;
    top: 50%;
    right: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--size-32);
    height: var(--size-64);
    outline: var(--border-width-md) solid var(--theme-frame);
    outline-offset: calc(var(--border-width-md) * -1);
    border-radius: var(--radius-sm) 0 0 var(--radius-sm); /* 9 */
    background-color: var(--theme-page-bg);
    transform: translateY(-50%);
    transition: color var(--transition-duration) var(--transition-easing);
  }
  .section-nav_tab:hover,
  .section-nav_tab:focus-visible {
    color: var(--theme-icon-secondary);
  }
  /* The frame is the focus ring: the global :focus-visible outline would be the same line */
  .section-nav_tab:focus-visible {
    outline-color: var(--theme-text);
  }
  /* The triangle points left (the panel comes from there) and turns to the right when the panel is open */
  .section-nav_arrow {
    width: var(--size-12);
    height: var(--size-12);
    transform: rotate(180deg);
    transition: transform var(--transition-duration) var(--transition-easing);
  }
  .section-nav_tab[aria-expanded='true'] .section-nav_arrow {
    transform: none;
  }
  /* safe: a list taller than the screen starts at the top instead of being cut off above it */
  .section-nav_panel {
    display: flex;
    flex-direction: column;
    justify-content: safe center;
    height: 100%;
    padding: var(--spacing-xl);
    overflow-y: auto;
    border-left: var(--border-width-md) solid var(--theme-frame);
    background-color: var(--theme-page-bg);
  }
  .section-nav_item {
    width: 100%;
    padding-block: var(--spacing-sm);
    text-align: left;
    transition: color var(--transition-duration) var(--transition-easing);
  }
  .section-nav_item:hover,
  .section-nav_item:focus-visible {
    color: var(--theme-text-accent);
  }
  /* The pause toggle under the list: a divider in the colour of the panel's frame */
  .section-nav_extra {
    margin-top: var(--spacing-sm);
    padding-top: var(--spacing-sm);
    border-top: var(--border-width-md) solid var(--theme-frame);
  }
  /* The square of the current screen / of the pressed toggle (the others keep its place) */
  .section-nav_mark {
    flex: none;
    opacity: 0;
    transition: opacity var(--transition-duration) var(--transition-easing);
  }
  .section-nav_item[aria-current='location'] .section-nav_mark,
  .section-nav_item[aria-pressed='true'] .section-nav_mark {
    opacity: 1;
  }

  @media (max-width: 479px) {
    .section-nav {
      width: calc(16.25rem * var(--fluid-scale)); /* 260 */
    }
    /* No wider than the side padding, so it never covers the content; the touch target stays 24 px wide */
    .section-nav_tab {
      width: var(--container-padding);
      height: var(--size-56);
    }
    .section-nav_tab::before {
      content: '';
      position: absolute;
      inset: 0 0 0 auto;
      width: max(24px, var(--size-24));
    }
    .section-nav_panel {
      padding: var(--size-20);
    }
  }
</style>

<script>
  // Open / close the panel (the jump itself is the engine's delegated [data-target-section] click), the mark of the
  // current screen and the pause of the background videos
  import { app, SECTION_EVENT } from '@/scripts/kulbit/app';
  import { backgroundVideosPaused, setBackgroundVideosPaused } from '@/scripts/kulbit/video';

  const nav = document.querySelector<HTMLElement>('[data-section-nav]');
  const toggle = nav?.querySelector<HTMLButtonElement>('[data-section-nav-toggle]');
  const panel = nav?.querySelector<HTMLElement>('[data-section-nav-panel]');
  const pause = nav?.querySelector<HTMLButtonElement>('[data-video-pause]');

  if (nav && toggle && panel) {
    const items = [...panel.querySelectorAll<HTMLElement>('[data-target-section]')];
    const markCurrent = (index: number) =>
      items.forEach((item) => {
        if (item.getAttribute('data-target-section') === String(index)) item.setAttribute('aria-current', 'location');
        else item.removeAttribute('aria-current');
      });
    document.addEventListener(SECTION_EVENT, (event) => markCurrent((event as CustomEvent<{ index: number }>).detail.index));

    const isOpen = () => nav.classList.contains('is--open');
    const setOpen = (open: boolean) => {
      nav.classList.toggle('is--open', open);
      toggle.setAttribute('aria-expanded', String(open));
      panel.inert = !open;
      if (open) panel.removeAttribute('aria-hidden');
      else panel.setAttribute('aria-hidden', 'true');
    };
    const showPaused = () => pause?.setAttribute('aria-pressed', String(backgroundVideosPaused()));
    const open = () => {
      markCurrent(app.currentSectionIndex);
      showPaused();
      setOpen(true);
    };
    const close = (focusToggle = false) => {
      if (!isOpen()) return;
      // The focus leaves the panel before it turns inert
      if (focusToggle || panel.contains(document.activeElement)) toggle.focus();
      setOpen(false);
    };

    toggle.addEventListener('click', () => (isOpen() ? close() : open()));
    pause?.addEventListener('click', () => {
      setBackgroundVideosPaused(pause.getAttribute('aria-pressed') !== 'true');
      showPaused();
    });
    // An item: the engine jumps, the panel closes
    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('[data-target-section]')) close(true);
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !nav.contains(event.target)) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) close(true);
    });
  }
</script>
