---
/**
 * SiteFooter — built from the Webflow build (kulbit-gsap export, «footer.section.footer», the last screen); values 1:1
 * from its CSS (1rem = 16px on the 1920 / 744 / 390 frames = our fluid scale). Rendered by BaseLayout inside
 * <footer class="footer"> (slot="footer"): padding and background live in .footer (utilities.css); with `steps` the
 * layout makes it the last [data-kulbit-section] — stacked over the sections, still the one <footer> landmark
 * outside <main>.
 *
 * The top: the big KULBIT mark (one file per breakpoint) and under it the logo + the copyright line. The bottom: three
 * columns — «Explore» (the Showreel card: back to the hero), «about» (the tagline, the sentence, «Let’s discuss») and
 * «contact us» (two links + LinkedIn / Gmail in an <address>). The column titles are the footer's <h2>s (each heads
 * its block); the tagline «Filmmaker Vision x AI Dimension» is a bold line of the about block, a <p>.
 * Order: «Explore» stands first on desktop, second on mobile and last on tablet (Webflow: CSS `order`, which
 * markup.md rules out — the DOM order must be the visual order). So it is here once per place, each copy shown by its
 * visibility utility (the hidden ones are display: none — out of the reading and Tab order; the same picture URL
 * loads once); «Let’s discuss» has its mobile copy at the end, as in Webflow.
 * The step scroll of tablet / mobile (the script below) moves [data-footer-content] when the footer is taller than
 * the screen.
 * The contacts are empty in site.ts (TODO): the links render without href until the client gives them.
 */
import { Picture } from 'astro:assets';
import FooterMark from '@/assets/icons/site-footer-label.svg';
import FooterMarkSmall from '@/assets/icons/site-footer-label-small.svg';
import IconLinkedin from '@/assets/icons/social-linkedin.svg';
import IconGmail from '@/assets/icons/social-gmail.svg';
import showreel from '@/assets/site-footer/footer-showreel.avif';
import Button from '@/components/ui/Button.astro';
import Logo from '@/components/ui/Logo.astro';
import { site } from '@/data/site';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale).siteFooter;

// A link that leaves the site opens in a new tab; an empty one stays without href (TODO: the addresses in site.ts)
const link = (href: string) => ({
  href: href || undefined,
  ...(href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
});
const contacts = [
  { text: t.contact.support, ...link(site.contactLinks.support) },
  { text: t.contact.partnership, ...link(site.contactLinks.partnership) },
];
const socials = [
  { name: t.contact.linkedin, Icon: IconLinkedin, ...link(site.socials.linkedin ?? '') },
  { name: t.contact.email, Icon: IconGmail, ...link(site.email ? `mailto:${site.email}` : '') },
];
// The columns in DOM order; «explore» with the visibility of its place
const columns = ['explore desktop-only', 'about', 'explore mobile-only', 'contact', 'explore desktop-hide mobile-hide'];
---

<div class="container">
  <div class="site-footer_layout flex-v" data-footer-content>
    <div class="site-footer_top">
      <div class="desktop-only"><FooterMark class="site-footer_mark" aria-hidden="true" /></div>
      <div class="desktop-hide"><FooterMarkSmall class="site-footer_mark" aria-hidden="true" /></div>
      <div class="site-footer_row text-size-16/16/13 text-style-uppercase">
        <Logo size="108" />
        <p>© {site.copyrightYear} {t.rights}</p>
      </div>
    </div>

    <div class="site-footer_bottom text-style-uppercase">
      {
        columns.map((column) => {
          const [name, ...visibility] = column.split(' ');
          if (name === 'explore') {
            return (
              <div class:list={['site-footer_explore', visibility]}>
                <div class="flex-v spacing-32/24/24 height-100">
                  <h2 class="site-footer_title text-size-18/16/16 text-weight-800">{t.explore.title}</h2>
                  {/* The hero is always section 0 (the engine's contract): no data-section-name needed on it */}
                  <Button variant="showreel" data-kulbit-border data-target-section="0">
                    <Picture
                      slot="media"
                      src={showreel}
                      formats={['avif', 'webp']}
                      fallbackFormat="jpg"
                      width={680}
                      alt=""
                      loading="eager"
                      class="site-footer_poster fill-box"
                    />
                    {t.explore.showreel}
                  </Button>
                </div>
              </div>
            );
          }
          if (name === 'about') {
            return (
              <div class="site-footer_card">
                <div class="flex-v spacing-32/24/24 height-100">
                  <h2 class="site-footer_title text-size-18/16/16 text-weight-800">{t.about.title}</h2>
                  <div class="site-footer_grow flex-v">
                    <div class="flex-v spacing-32">
                      <p class="site-footer_tagline text-size-18/16/16 text-weight-800">{t.about.tagline}</p>
                      <p class="site-footer_text text-size-16 text-weight-700">
                        {t.about.text.map((part, i) => (
                          <Fragment>
                            {i > 0 && ' '}
                            {part.grey ? <span class="site-footer_grey">{part.text}</span> : part.text}
                          </Fragment>
                        ))}
                      </p>
                    </div>
                    <div class="flex-v mobile-hide">
                      {/* TODO: where «Let’s discuss» leads (the same question as «Start Your Pilot») */}
                      <Button variant="second-footer" data-kulbit-border>
                        {t.about.discuss}
                      </Button>
                    </div>
                  </div>
                </div>
              </div>
            );
          }
          return (
            <div class="site-footer_card">
              <div class="flex-v spacing-32/24/24 height-100">
                <h2 class="site-footer_title text-size-18/16/16 text-weight-800">{t.contact.title}</h2>
                <address class="site-footer_contacts flex-v text-size-16">
                  <ul class="flex-v align-start spacing-16/16/24">
                    {contacts.map(({ text, ...attrs }) => (
                      <li>
                        <a class="site-footer_link" {...attrs}>
                          {text}
                        </a>
                      </li>
                    ))}
                  </ul>
                  <ul class="flex-h align-start spacing-24">
                    {socials.map(({ name, Icon, ...attrs }) => (
                      <li>
                        <a class="site-footer_social" {...attrs}>
                          <span class="sr-only">{name}</span>
                          <Icon aria-hidden="true" />
                        </a>
                      </li>
                    ))}
                  </ul>
                </address>
              </div>
            </div>
          );
        })
      }
      <div class="flex-v mobile-only">
        {/* TODO: where «Let’s discuss» leads (the same question as «Start Your Pilot») */}
        <Button variant="second-footer" data-kulbit-border>
          {t.about.discuss}
        </Button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Decima Mono 16 / 1.1, tracking 0.03em (mobile 13): .text-size-section-label */
  .text-size-16\/16\/13 {
    font-size: var(--size-16);
    line-height: 1.1;
    letter-spacing: 0.03em;
  }
  /* PP Monument Wide Black 18 / 1.3, tracking 0.03em (tablet 16): .text-size-footer-label, .text-size-footer-heading */
  .text-size-18\/16\/16 {
    font-family: var(--font-secondary);
    font-size: calc(1.13rem * var(--fluid-scale));
    line-height: 1.3;
    letter-spacing: 0.03em;
  }
  /* Decima Mono 16 / 1.1, tracking 0.03em: .text-size-footer (the body's size and line height) */
  .text-size-16 {
    font-size: var(--size-16);
    line-height: 1.1;
    letter-spacing: 0.03em;
  }
  /* .flex-v.gap-32-24-24 */
  .spacing-32\/24\/24 {
    gap: var(--size-32);
  }
  /* .flex-v.gap-32 */
  .spacing-32 {
    gap: var(--size-32);
  }
  /* .flex-v.align-start.gap-16-16-24 */
  .spacing-16\/16\/24 {
    gap: var(--size-16);
  }
  /* .flex-h.align-start.gap-24 */
  .spacing-24 {
    gap: var(--size-24);
  }

  /* .container.is-footer (min-height 100 %): the content fills the footer — the screen (the stacked sections are
     100vh) minus the .footer padding (utilities.css) — and grows past it; 4rem between top and bottom */
  .site-footer_layout {
    gap: var(--size-64);
    min-height: calc(100vh - var(--size-80) * 2);
  }

  /* ---------- Top (.footer-top): the mark over the logo row, at the bottom of a fixed-height block ---------- */
  .site-footer_top {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: calc(19.63rem * var(--fluid-scale)); /* 314 */
  }
  /* .footer-label_svg */
  .site-footer_mark {
    position: absolute;
    inset: 0 0 auto;
    z-index: 0;
    width: 100%;
    height: auto;
    pointer-events: none;
  }
  /* .footer-top_label: over the mark, the white line on top */
  .site-footer_row {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--size-16); /* min gap, not in the design (space-between) */
    padding-top: var(--size-20);
    border-top: var(--size-2) solid var(--theme-text);
  }

  /* ---------- Bottom (.footer-bottom): three columns at the bottom of the footer ---------- */
  .site-footer_bottom {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: calc(12.5rem * var(--fluid-scale)); /* 200 */
    margin-top: auto;
    padding-inline: calc(4.38rem * var(--fluid-scale)); /* 70 */
  }
  /* .text-size-footer-label: the line under the title */
  .site-footer_title {
    padding-bottom: var(--size-12);
    border-bottom: var(--size-2) solid #252525;
  }
  /* .flex-v.justify-space-between.is-grow: the button at the bottom of the column («Let’s discuss»: margin-top 2rem) */
  .site-footer_grow {
    flex: 1;
    justify-content: space-between;
    gap: var(--size-32);
  }
  /* .width-230 */
  .site-footer_tagline {
    width: calc(14.38rem * var(--fluid-scale)); /* 230 */
  }
  /* .width-299-299-a + .text-size-footer: justified */
  .site-footer_text {
    width: calc(18.69rem * var(--fluid-scale)); /* 299 */
    text-align: justify;
  }
  /* .text-color-black-20 */
  .site-footer_grey {
    color: #404040;
  }
  /* .footer-social-wrapper: the links at the top, the icons at the bottom */
  .site-footer_contacts {
    align-items: flex-start;
    justify-content: space-between;
    height: calc(9.5rem * var(--fluid-scale)); /* 152 */
  }
  /* A block, as the Webflow link (a flex item there); TODO: not in the design — the site's defaults for a text link
     and a coloured icon, once they have an href */
  .site-footer_link {
    display: block;
    transition: color var(--transition-duration) var(--transition-easing);
  }
  .site-footer_link[href]:hover,
  .site-footer_link[href]:focus-visible {
    color: var(--theme-text-brand);
  }
  /* .icon-32-32-24 */
  .site-footer_social {
    display: block;
    width: var(--size-32);
    aspect-ratio: 1;
    transition: transform var(--transition-duration) var(--transition-easing);
  }
  .site-footer_social[href]:hover,
  .site-footer_social[href]:focus-visible {
    transform: scale(1.1);
  }
  .site-footer_social svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 991px) {
    .text-size-18\/16\/16 {
      font-size: var(--size-16);
    }
    .site-footer_layout {
      min-height: calc(100vh - var(--size-16) - var(--size-100));
    }
    .spacing-32\/24\/24 {
      gap: var(--size-24);
    }
    .site-footer_top {
      height: calc(11.5rem * var(--fluid-scale)); /* 184 */
      min-height: calc(11.5rem * var(--fluid-scale));
    }
    /* the white line under the row */
    .site-footer_row {
      padding-top: 0;
      padding-bottom: var(--size-20);
      border-top: none;
      border-bottom: var(--size-2) solid var(--theme-text);
    }
    /* Two columns in a row, «Explore» below them over the whole width (it wraps) and down at the bottom */
    .site-footer_bottom {
      display: flex;
      flex: 1;
      flex-wrap: wrap;
      gap: var(--size-80);
      padding-inline: 0;
    }
    .site-footer_card {
      flex: 1;
    }
    .site-footer_explore {
      flex: 1;
      margin-top: auto;
    }
    /* The Showreel picture: its top (desktop: centred, the default) */
    .site-footer_poster {
      object-position: 50% 0;
    }
    .site-footer_contacts {
      height: calc(9rem * var(--fluid-scale)); /* 144 */
    }
  }

  @media (max-width: 479px) {
    .text-size-16\/16\/13 {
      font-size: calc(0.81rem * var(--fluid-scale));
    }
    .site-footer_layout {
      min-height: calc(100vh - var(--size-32) - var(--size-64));
    }
    .spacing-16\/16\/24 {
      gap: var(--size-24);
    }
    .site-footer_top {
      height: calc(10rem * var(--fluid-scale)); /* 160 (the tablet min-height 184 stays, as in Webflow) */
    }
    /* One column: about, Explore, contact us, «Let’s discuss» */
    .site-footer_bottom {
      flex-direction: column;
      flex-wrap: nowrap;
      justify-content: space-between;
    }
    .site-footer_text {
      width: auto;
    }
    .site-footer_contacts {
      gap: calc(1.88rem * var(--fluid-scale)); /* 30 */
      height: auto;
    }
    .site-footer_social {
      width: var(--size-24);
    }
  }
</style>

<script>
  // Step scroll of the footer — port of kulbit-webflow buildFooterScroll (03-sections.js, block 03h; ADR-020), the same
  // numbers. Tablet / mobile only, and only when the content is taller than the visible screen (by more than 4 px):
  // the footer is clipped to the visible height and one gesture moves its content by 0.85 of it (stepDuration, ease);
  // at the bottom the gesture is eaten (the footer stays), at the top the engine goes to the previous section. The
  // engine's prepare (sliding in) and reset (a jump, a restore) bring it back to the top; a resize (the iOS address
  // bar, a rotation) measures again. Desktop: no controller. The source has no collapse.
  // Differences from the source: the content is found by data-footer-content and moved (the source moved
  // .container.is-footer and set its height to auto first — here the content already grows past its min-height); the
  // footer is measured with overflow hidden (the source's .section has it in its CSS); the visible height is the
  // engine's visibleHeight() (the source read the same wrapper height).
  import { gsap } from 'gsap';
  import { app, config, registerSectionBuilder, visibleHeight } from '@/scripts/kulbit/app';

  const STEP_RATIO = 0.85; // the share of the visible height per gesture

  registerSectionBuilder((mode) => {
    if (mode === 'desktop') return;
    const footer = app.sections.find((s) => s.isFooter);
    const content = footer?.el.querySelector<HTMLElement>('[data-footer-content]');
    if (!footer || !content) return;
    const el = footer.el;

    // The inline styles to give back on a breakpoint change (the engine set height 100vh)
    const savedHeight = el.style.height;
    const savedOverflow = el.style.overflow;

    // Clipped to the visible height: does the content overflow it? Measured as a scroll container (Webflow's
    // .section has overflow hidden), so the bottom padding counts
    el.style.height = `${visibleHeight()}px`;
    el.style.overflow = 'hidden';
    if (el.scrollHeight - el.clientHeight <= 4) {
      el.style.height = savedHeight;
      el.style.overflow = savedOverflow;
      return;
    }
    content.style.willChange = 'transform';

    let pos = 0;
    let maxShift = 0;
    let stepPx = 0;
    const recompute = () => {
      el.style.height = `${visibleHeight()}px`;
      maxShift = Math.max(0, el.scrollHeight - el.clientHeight);
      stepPx = Math.round(visibleHeight() * STEP_RATIO);
      pos = Math.min(pos, maxShift);
      gsap.set(content, { y: -pos });
    };
    recompute();
    // Entering the footer: always from its top
    const toTop = () => {
      pos = 0;
      recompute();
      gsap.set(content, { y: 0 });
    };
    window.visualViewport?.addEventListener('resize', recompute);
    window.addEventListener('resize', recompute);

    footer.controller = {
      step(dir) {
        if (maxShift <= 0) return false; // it fits now (a rotation): a regular section
        if (dir > 0) {
          if (pos >= maxShift) return true; // at the bottom: the gesture is eaten
          pos = Math.min(pos + stepPx, maxShift);
        } else {
          if (pos <= 0) return false; // at the top: the previous section
          pos = Math.max(pos - stepPx, 0);
        }
        app.isAnimating = true;
        gsap.to(content, {
          y: -pos,
          duration: config.stepDuration,
          ease: config.ease,
          onComplete: () => {
            app.isAnimating = false;
          },
        });
        return true;
      },
      prepare: toTop,
      reset: toTop,
      dispose() {
        window.visualViewport?.removeEventListener('resize', recompute);
        window.removeEventListener('resize', recompute);
        gsap.killTweensOf(content);
        gsap.set(content, { clearProps: 'transform' });
        content.style.willChange = '';
        el.style.height = savedHeight;
        el.style.overflow = savedOverflow;
      },
    };
  });
</script>
