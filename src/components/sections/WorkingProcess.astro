---
/**
 * WorkingProcess — built from the Webflow build (kulbit-gsap export, «section.is-working-process», right after the
 * intro screen); values 1:1 from its CSS (1rem = 16px on the 1920 / 744 / 390 frames = our fluid scale).
 *
 * The diagram (one inline SVG per breakpoint: the dotted scale with its dots, the three arrows, the blue and the red
 * progress lines), its legend Kulbit / Traditional and the weeks under it; the three stage cards stacked in the
 * centre (label, title, «The “Why”», the tags with their dashed branches, the red arrow square) and «Scroll to see
 * more» on desktop. The steps (the script below, a port of kulbit-webflow buildWorkingProcess, ADR-019 + its SVG
 * iteration): the section appears (the diagram draws itself, the legend, the weeks, the lines, the first arrow turns
 * white, the cards form their stack), then one gesture = the active card falls while the next one takes the centre
 * and the next arrow turns white.
 * The root is a <div>, not a <section>: the heading of the working process is the visible <h2> of the intro screen
 * right before it (the Webflow build repeats it here as an sr-only <h2> with the same text), so the stage <h3>s
 * continue its outline instead of opening a second «Working process».
 * The markup is the natural state: the first card in front, the others hidden right under it.
 */
import IconArrow from '@/assets/icons/arrow-pilot.svg';
import Square from '@/components/ui/Square.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale).workingProcess;

// Per card: the max width of the title (the head keeps the title's lines as in the design)
const heads = ['max-width--400/456/235', 'max-width--320/320/248', 'max-width--368/368/240'];
---

<div class="section padding-top-32 padding-bottom-md" id="working-process" data-kulbit-section>
  <div class="container">
    <div class="flex-v spacing-48/96/64">
      <div class="position-relative text-style-uppercase">
        <div class="desktop-only">
          <svg class="working-process_diagram" viewBox="0 0 1750 207" fill="none" aria-hidden="true">
            <path data-kulbit-svg-line="bg" d="M0 195 L1740 195" />
            <path data-kulbit-svg-tail d="M1749 195L1739 189.227L1739 200.774L1749 195Z" />
            <path data-kulbit-svg-line="blue" d="M59.5 195H1151.5" />
            <path data-kulbit-svg-line="red" d="M1151.5 195L1705.5 195" />
            <path data-kulbit-svg-arrow="1" data-kulbit-svg-part="fill" d="M204.056 71C123.944 71 59 121.7 59 184.242L351 185C350.353 170.845 342.355 150.118 338.437 141.523C316.838 100.157 264.809 71 204.056 71Z" fill="url(#working-process-grad-arrow-1-d)" />
            <path data-kulbit-svg-arrow="1" data-kulbit-svg-part="line" d="M59 184 C 60 122.362 124.198 72 203.939 72 C 260.478 72 309.304 97.3628 332.849 134.128 L 338.212 141.373" />
            <path data-kulbit-svg-arrow="1" data-kulbit-svg-part="head" d="M338.212 141.373L338.183 129.826L328.197 135.624L338.212 141.373Z" />
            <path data-kulbit-svg-arrow="2" data-kulbit-svg-part="fill" d="M536.298 29C434.51 29 351.994 98.379 351.994 183.962L722.999 185C722.177 165.63 712.016 137.266 707.037 125.506C679.595 68.8984 613.488 29 536.298 29Z" fill="url(#working-process-grad-arrow-2-d)" />
            <path data-kulbit-svg-arrow="2" data-kulbit-svg-part="line" d="M351 184 C 352 99.1059 434.138 30 535.845 30 C 609.266 30 672.555 66.0467 702.024 118.051 L 707.086 125.529" />
            <path data-kulbit-svg-arrow="2" data-kulbit-svg-part="head" d="M707.086 125.529L707.541 113.991L697.321 119.366L707.086 125.529Z" />
            <path data-kulbit-svg-arrow="3" data-kulbit-svg-part="fill" d="M938.101 6C819.304 6 723 86.0527 723 184.803L1156 186C1155.04 163.65 1143.18 130.922 1137.37 117.353C1105.34 52.0367 1028.19 6 938.101 6Z" fill="url(#working-process-grad-arrow-3-d)" />
            <path data-kulbit-svg-arrow="3" data-kulbit-svg-part="line" d="M723 184 C 724 86.4117 819.355 7 937.389 7 C 1023.16 7 1097.03 48.9677 1130.94 109.375 L 1136 116.853" />
            <path data-kulbit-svg-arrow="3" data-kulbit-svg-part="head" d="M1136 116.853L1136.46 105.315L1126.24 110.689L1136 116.853Z" />
            <circle data-kulbit-svg-dot="1" cx="59.5" cy="194.5" r="11" />
            <circle cx="59.5" cy="194.5" r="4.5" fill="var(--theme-illustration)" />
            <circle data-kulbit-svg-dot="2" cx="351.5" cy="194.5" r="11" />
            <circle cx="351.5" cy="194.5" r="4.5" fill="var(--theme-illustration)" />
            <circle data-kulbit-svg-dot="3" cx="722.5" cy="194.5" r="11" />
            <circle cx="722.5" cy="194.5" r="4.5" fill="var(--theme-illustration)" />
            <circle data-kulbit-svg-dot="4" cx="1151.5" cy="194.5" r="11" />
            <circle cx="1151.5" cy="194.5" r="4.5" fill="var(--theme-illustration)" />
            <circle data-kulbit-svg-dot="5" cx="1705.5" cy="194.5" r="11" />
            <circle cx="1705.5" cy="194.5" r="4.5" fill="var(--theme-illustration)" />
            <defs>
              <linearGradient id="working-process-grad-arrow-1-d" x1="213.223" y1="68.4723" x2="213.223" y2="184.747" gradientUnits="userSpaceOnUse">
                <stop stop-color="var(--theme-icon-secondary)" stop-opacity="0.3" />
                <stop offset="0.401559" stop-color="var(--theme-icon-secondary)" stop-opacity="0.15" />
                <stop offset="0.88746" stop-color="var(--theme-icon-secondary)" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="working-process-grad-arrow-2-d" x1="547.945" y1="25.541" x2="547.945" y2="184.654" gradientUnits="userSpaceOnUse">
                <stop stop-color="var(--theme-icon-secondary)" stop-opacity="0.3" />
                <stop offset="0.401559" stop-color="var(--theme-icon-secondary)" stop-opacity="0.15" />
                <stop offset="0.88746" stop-color="var(--theme-icon-secondary)" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="working-process-grad-arrow-3-d" x1="951.694" y1="2.00885" x2="951.694" y2="185.601" gradientUnits="userSpaceOnUse">
                <stop stop-color="var(--theme-icon-secondary)" stop-opacity="0.3" />
                <stop offset="0.401559" stop-color="var(--theme-icon-secondary)" stop-opacity="0.15" />
                <stop offset="0.88746" stop-color="var(--theme-icon-secondary)" stop-opacity="0" />
              </linearGradient>
            </defs>
          </svg>
        </div>
        <div class="desktop-hide mobile-hide">
          <div class="working-process_svg">
            <svg class="working-process_diagram" viewBox="0 0 680 87" fill="none" aria-hidden="true">
              <path data-kulbit-svg-line="bg" d="M0 77 L671 77" />
              <path data-kulbit-svg-tail d="M680 77L670 71.227L670 82.774L680 77Z" />
              <path data-kulbit-svg-line="blue" d="M10 77H385" />
              <path data-kulbit-svg-line="red" d="M385 77L656 77" />
              <path data-kulbit-svg-arrow="1" data-kulbit-svg-part="fill" d="M61.6639 25C33.1307 25 10 44.0588 10 67.569L114 67.854C113.77 62.5329 110.921 54.7413 109.526 51.5106C101.833 35.9603 83.3018 25 61.6639 25Z" fill="url(#working-process-grad-arrow-1-t)" />
              <path data-kulbit-svg-arrow="1" data-kulbit-svg-part="line" d="M10 67.4781 C 11 44.7439 33.4731 26 61.6222 26 C 79.2594 26 94.7376 33.39 103.787 44.5239 L 109.445 51.454" />
              <path data-kulbit-svg-arrow="1" data-kulbit-svg-part="head" d="M109.445 51.454L108.871 39.9213L99.1704 46.1852L109.445 51.454Z" />
              <path data-kulbit-svg-arrow="2" data-kulbit-svg-part="fill" d="M176.593 14C142.024 14 114 38.2398 114 68.1411L240 68.5037C239.721 61.736 236.27 51.8263 234.579 47.7173C225.259 27.9398 202.808 14 176.593 14Z" fill="url(#working-process-grad-arrow-2-t)" />
              <path data-kulbit-svg-arrow="2" data-kulbit-svg-part="line" d="M114 68.0256 C 115 38.8727 142.411 15 176.542 15 C 198.849 15 218.336 25.2222 229.121 40.4575 L 234.482 47.6454" />
              <path data-kulbit-svg-arrow="2" data-kulbit-svg-part="head" d="M234.482 47.6454L234.414 36.0986L224.448 41.9306L234.482 47.6454Z" />
              <path data-kulbit-svg-arrow="3" data-kulbit-svg-part="fill" d="M312.031 6.25537C272.25 6.25537 240 33.8258 240 67.8357L385 68.2481C384.679 60.5505 380.707 49.2791 378.762 44.6056C368.036 22.1106 342.2 6.25537 312.031 6.25537Z" fill="url(#working-process-grad-arrow-3-t)" />
              <path data-kulbit-svg-arrow="3" data-kulbit-svg-part="line" d="M240 67.7043 C 241 34.4617 272.622 7.25537 311.973 7.25537 C 338.194 7.25537 361.04 19.363 373.322 37.2937 L 378.65 44.5238" />
              <path data-kulbit-svg-arrow="3" data-kulbit-svg-part="head" d="M378.65 44.5238L378.647 32.9768L368.648 38.7526L378.65 44.5238Z" />
              <circle data-kulbit-svg-dot="1" cx="10" cy="77" r="9.5" />
              <circle cx="10" cy="77" r="4" fill="var(--theme-illustration)" />
              <circle data-kulbit-svg-dot="2" cx="113" cy="77" r="9.5" />
              <circle cx="113" cy="77" r="4" fill="var(--theme-illustration)" />
              <circle data-kulbit-svg-dot="3" cx="240" cy="77" r="9.5" />
              <circle cx="240" cy="77" r="4" fill="var(--theme-illustration)" />
              <circle data-kulbit-svg-dot="4" cx="385" cy="77" r="9.5" />
              <circle cx="385" cy="77" r="4" fill="var(--theme-illustration)" />
              <circle data-kulbit-svg-dot="5" cx="656" cy="77" r="9.5" />
              <circle cx="656" cy="77" r="4" fill="var(--theme-illustration)" />
              <defs>
                <linearGradient id="working-process-grad-arrow-1-t" x1="64.9289" y1="24.0498" x2="64.9289" y2="67.759" gradientUnits="userSpaceOnUse">
                  <stop stop-color="var(--theme-icon-secondary)" stop-opacity="0.5" />
                  <stop offset="0.88746" stop-color="var(--theme-icon-secondary)" stop-opacity="0" />
                </linearGradient>
                <linearGradient id="working-process-grad-arrow-2-t" x1="180.548" y1="12.7915" x2="180.548" y2="68.3828" gradientUnits="userSpaceOnUse">
                  <stop stop-color="var(--theme-icon-secondary)" stop-opacity="0.5" />
                  <stop offset="0.88746" stop-color="var(--theme-icon-secondary)" stop-opacity="0" />
                </linearGradient>
                <linearGradient id="working-process-grad-arrow-3-t" x1="316.584" y1="4.8808" x2="316.584" y2="68.1106" gradientUnits="userSpaceOnUse">
                  <stop stop-color="var(--theme-icon-secondary)" stop-opacity="0.5" />
                  <stop offset="0.88746" stop-color="var(--theme-icon-secondary)" stop-opacity="0" />
                </linearGradient>
              </defs>
            </svg>
          </div>
        </div>
        <div class="mobile-only">
          <div class="working-process_svg">
            <svg class="working-process_diagram" viewBox="0 0 358 84" fill="none" aria-hidden="true">
              <path data-kulbit-svg-line="bg" d="M0 73.1934 L349 73.1934" />
              <path data-kulbit-svg-tail d="M358 73.1934L348 67.4199L348 78.9669L358 73.1934Z" />
              <path data-kulbit-svg-line="blue" d="M10 73.1934H162" />
              <path data-kulbit-svg-line="red" d="M162 73.1934L334 73.1934" />
              <path data-kulbit-svg-arrow="1" data-kulbit-svg-part="fill" d="M85.5088 1C43.8064 1 10 29.1256 10 63.8202L162 64.2409C161.663 56.3883 157.5 44.89 155.46 40.1224C144.217 17.1744 117.133 1 85.5088 1Z" fill="url(#working-process-grad-arrow-1-m)" />
              <path data-kulbit-svg-arrow="1" data-kulbit-svg-part="line" d="M10 63.6861 C 11 29.7833 44.15 2 85.4479 2 C 113.061 2 137.101 14.4542 149.946 32.8636 L 155.343 40.0389" />
              <path data-kulbit-svg-arrow="1" data-kulbit-svg-part="head" d="M155.343 40.0389L155.228 28.4925L145.286 34.3657L155.343 40.0389Z" />
              <circle data-kulbit-svg-dot="1" cx="10" cy="73.2" r="9.5" />
              <circle cx="10" cy="73.2" r="3.0" fill="var(--theme-illustration)" />
              <circle data-kulbit-svg-dot="2" cx="162" cy="73.2" r="9.5" />
              <circle cx="162" cy="73.2" r="3.0" fill="var(--theme-illustration)" />
              <circle data-kulbit-svg-dot="3" cx="334" cy="73.2" r="9.5" />
              <circle cx="334" cy="73.2" r="3.0" fill="var(--theme-illustration)" />
              <defs>
                <linearGradient id="working-process-grad-arrow-1-m" x1="90.2807" y1="-0.402244" x2="90.2807" y2="64.1006" gradientUnits="userSpaceOnUse">
                  <stop stop-color="var(--theme-icon-secondary)" stop-opacity="0.5" />
                  <stop offset="0.88746" stop-color="var(--theme-icon-secondary)" stop-opacity="0" />
                </linearGradient>
              </defs>
            </svg>
          </div>
        </div>
        <ul class="text-size-process-label text-weight-700">
          <li class="working-process_label" data-process-label="kulbit"><Square size="12" />{t.legend.kulbit}</li>
          <li class="working-process_label label--second" data-process-label="traditional">
            <Square size="12" color="red" />{t.legend.traditional}
          </li>
        </ul>
        <ul class="text-size-process-week text-weight-800">
          {
            t.weeks.map((week, i) => (
              <li class:list={['working-process_week', { [`week--${i + 1}`]: i > 0, 'mobile-hide': i < 2 }]} data-process-week>
                {week}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="position-relative" data-process-cards>
        <ol class="flex-h justify-center">
          {
            t.stages.map((stage, i) => (
              <li class:list={['working-process_card', { 'card--stacked': i > 0 }]} data-process-card>
                <div class="flex-v spacing-16/16/8 text-style-uppercase">
                  <p class="text-size-process-label text-weight-700 text-color-accent">{stage.label}</p>
                  <div class:list={['working-process_head', heads[i]]}>
                    <h3 class="text-size-h3 text-weight-800">{stage.title}</h3>
                  </div>
                </div>
                <p class="working-process_number text-size-process-number" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </p>
                <p class="working-process_why text-size-list">
                  {stage.why[0]}
                  <br />
                  {stage.why[1]}
                </p>
                <div class="working-process_categories text-style-uppercase">
                  <ul class="working-process_tags text-size-process-category text-weight-700">
                    {stage.tags.map((row, r) =>
                      row.map((tag, j) => (
                        <li class:list={['working-process_tag', { 'row--next': r > 0, 'row--start': r > 0 && j === 0 }]}>
                          {tag}
                        </li>
                      )),
                    )}
                  </ul>
                  <div class="working-process_lines" aria-hidden="true">
                    <div class="working-process_dash" />
                    <div class="working-process_dash dash--second" />
                  </div>
                </div>
                <IconArrow class="working-process_arrow text-color-brand" aria-hidden="true" />
              </li>
            ))
          }
        </ol>
        <div class="desktop-only">
          <div class="working-process_more">
            <p class="text-size-hero text-weight-700 text-style-uppercase">{t.scroll[0]}<br />{t.scroll[1]}</p>
            <Square size="24/24/16" />
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* .section.is-working-process: 2rem on top everywhere (it beats the tablet / mobile .section rules); the bottom
     is .section's (padding-bottom-md) */
  .padding-top-32 {
    padding-top: var(--size-32);
  }
  /* .flex-v.gap-48-96-64 */
  .spacing-48\/96\/64 {
    gap: var(--size-48);
  }
  /* .flex-v.gap-16-16-8 */
  .spacing-16\/16\/8 {
    gap: var(--size-16);
  }

  /* Decima Mono Bold 16 / 1.3, tracking 0.03em (mobile 14): .working-process-label */
  .text-size-process-label {
    font-size: var(--size-16);
    line-height: 1.3;
    letter-spacing: 0.03em;
  }
  /* PP Monument Wide Black 16 / 1.15 (tablet 14, mobile 11): .working-process-week */
  .text-size-process-week {
    font-family: var(--font-secondary);
    font-size: var(--size-16);
    line-height: 1.15;
  }
  /* PP Monument Wide 64 / 1.3 (tablet 56, mobile 32): .working-process-card-number */
  .text-size-process-number {
    font-family: var(--font-secondary);
    font-size: var(--size-64);
    line-height: 1.3;
  }
  /* PP Monument Wide 20 / 1.3, tracking 0.03em (tablet 18 / 1.1, mobile 15 / 1.1): .text-size-list */
  .text-size-list {
    font-family: var(--font-secondary);
    font-size: var(--size-20);
    line-height: 1.3;
    letter-spacing: 0.03em;
  }
  /* Decima Mono Bold 16 / 1.3, tracking 0.03em (mobile 13 / 1, tracking 0.01em): .working-process-text-category */
  .text-size-process-category {
    font-size: var(--size-16);
    line-height: 1.3;
    letter-spacing: 0.03em;
  }

  /* ---------- Diagram (.working-process-svg): the SVG fills the width, its height follows the viewBox ---------- */
  .working-process_diagram {
    width: 100%;
    height: auto;
  }
  /* The styles the Webflow SVGs carried in their own <style> (the Webflow colour variables, here the theme tokens; its
     rule for the gradient stops inside the fill path is dropped: the stops live in <defs>, it matched nothing) */
  .working-process_diagram [data-kulbit-svg-line='bg'],
  .working-process_diagram [data-kulbit-svg-arrow][data-kulbit-svg-part='line'] {
    fill: none;
    stroke: var(--theme-border);
    stroke-width: 2;
    stroke-dasharray: 2 4;
  }
  .working-process_diagram [data-kulbit-svg-tail],
  .working-process_diagram [data-kulbit-svg-arrow][data-kulbit-svg-part='head'] {
    fill: var(--theme-border);
  }
  .working-process_diagram [data-kulbit-svg-line='blue'] {
    fill: none;
    stroke: var(--theme-icon-secondary);
    stroke-width: 2;
  }
  .working-process_diagram [data-kulbit-svg-line='red'] {
    fill: none;
    stroke: var(--theme-icon-brand);
    stroke-width: 2;
  }
  .working-process_diagram [data-kulbit-svg-arrow][data-kulbit-svg-part='fill'] {
    opacity: 0;
  }
  /* The rings are white discs as on the live Webflow build: its own rule says fill: none, but the SVG <style> of
     the traditional production section sets [data-kulbit-svg-dot] { fill: white } for the whole page */
  .working-process_diagram [data-kulbit-svg-dot] {
    fill: var(--theme-illustration);
    stroke: var(--theme-border);
  }

  /* ---------- Legend (.working-process-label-wrapper): Kulbit at the top left, Traditional under the red end ---------- */
  .working-process_label {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
  }
  .working-process_label.label--second {
    top: auto;
    right: var(--size-32);
    bottom: calc(-1.55rem * var(--fluid-scale)); /* -24.8 */
    left: auto;
  }
  /* ---------- Weeks (.working-process-week): under the dots ---------- */
  .working-process_week {
    position: absolute;
    bottom: calc(1.9rem * var(--fluid-scale)); /* 30.4 */
    left: calc(15.35rem * var(--fluid-scale)); /* 245.6 */
  }
  .working-process_week.week--2 {
    left: calc(36.9rem * var(--fluid-scale)); /* 590.4 */
  }
  .working-process_week.week--3 {
    left: calc(63.7rem * var(--fluid-scale)); /* 1019.2 */
  }
  .working-process_week.week--4 {
    left: calc(98.06rem * var(--fluid-scale)); /* 1569 */
  }

  /* ---------- Cards (.working-process-card): the first in the flow, centred; the others right on top of it ---------- */
  .working-process_card {
    position: relative;
    z-index: 1;
    display: flex;
    flex: none;
    flex-direction: column;
    gap: var(--spacing-lg);
    width: calc(39rem * var(--fluid-scale)); /* 624 */
    height: calc(38.13rem * var(--fluid-scale)); /* 610 */
    padding: var(--size-32);
    outline: var(--border-width-md) solid var(--theme-border);
    outline-offset: calc(var(--border-width-md) * -1);
    border-radius: var(--radius-sm); /* 9 */
    background-color: var(--theme-page-bg);
  }
  /* .working-process-card.is-second: absolute; centred by CSS (the source centred it by left 50 % + a pixel margin
     measured once, which drifts when the window is resized) */
  .working-process_card.card--stacked {
    position: absolute;
    inset: 0 0 auto;
    z-index: 0;
    margin-inline: auto;
  }
  /* .working-process-card-head (.is-two / .is-three: the max widths below) */
  .working-process_head {
    min-height: var(--size-72);
  }
  .max-width--400\/456\/235 {
    max-width: calc(25rem * var(--fluid-scale));
  }
  .max-width--320\/320\/248 {
    max-width: calc(20rem * var(--fluid-scale));
  }
  .max-width--368\/368\/240 {
    max-width: calc(23rem * var(--fluid-scale));
  }
  .working-process_number {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(8.75rem * var(--fluid-scale)); /* 140 */
    aspect-ratio: 1;
    outline: var(--border-width-md) solid var(--theme-border);
    outline-offset: calc(var(--border-width-md) * -1);
    border-radius: var(--radius-sm); /* 9 */
  }
  /* The «Why» — one paragraph with the disc of the Webflow list (<ul> with one <li>) */
  .working-process_why {
    display: list-item;
    margin-left: var(--size-24);
    list-style-type: disc;
  }
  /* .working-process-card-category-wrapper: at the bottom of the card, the dashed branches on its left */
  .working-process_categories {
    position: relative;
    margin-top: auto;
    padding-left: var(--size-24);
  }
  /* The tags go in rows (Webflow: a grid of rows 1.5rem apart, two tags in a row 0.5rem apart): they float, a row
