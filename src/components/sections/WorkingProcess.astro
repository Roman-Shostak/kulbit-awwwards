</style>

<script>
  // Steps of the section — port of kulbit-webflow buildWorkingProcess (03-sections.js, block 03g; ADR-019 and its
  // SVG iteration), the same numbers. maxState = cards − 1, the state = the active card.
  //   REVEAL (enter, paused revealTL at ×1.7, the gestures wait for its end): the dotted scale is drawn by a clip-rect
  //     sweep and each dot lights up when the sweep reaches it → the tail → the three grey arrows one after another →
  //     the Kulbit label → the weeks → the blue then the red line (strokeDashoffset) together with arrow 1 drawn by a
  //     white clone over the grey one + its gradient + a white head, dots 1 and 2 turn white → the cards rise and the
  //     next two slide out from under the first one into the stack → the Traditional label.
  //   STEP (stepTo): the active card falls (desktop: down-left with a turn; tablet / mobile: straight down) while the
  //     next one takes the centre and the next arrow turns white with it; its dot turns white right after. Back = the
  //     reverse. The last dot (the red end, «Traditional») stays grey.
  //   collapse (the section slides away downwards) = the reveal reversed ×5; reset(toEnd) = the reveal at its end +
  //     the instant state of the start / the last card.
  // Mobile has one arrow and three dots in its SVG: the steps move only the cards there, as in the source.
  // Differences from the source: the elements are found by data-process-* attributes (not the Webflow classes); the
  // stacked cards are absolute and centred in CSS (.card--stacked) instead of left 50 % + margin-left −cardW / 2 set
  // here; the overlay is found by data-process-overlay (not a class); the white is --theme-text (the source read
  // --colors--white-10, #fdfcfc — the same value); the active SVG = the visible one whose wrapper has an offsetParent
  // (an <svg> has no offsetParent of its own: in the source that check was always true).
  import { gsap } from 'gsap';
  import { app, motion, reducedMotion, registerSectionBuilder, type SectionController } from '@/scripts/kulbit/app';

  const cardsWrapper = document.querySelector<HTMLElement>('[data-process-cards]');
  const root = cardsWrapper?.closest<HTMLElement>('[data-kulbit-section]') ?? null;

  registerSectionBuilder((mode) => {
    const section = app.sections.find((s) => s.el === root);
    if (!section || !root || !cardsWrapper) return;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-process-card]')];
    if (cards.length < 2) return;

    const NS = 'http://www.w3.org/2000/svg';
    const VERTICAL = mode !== 'desktop';
    const FALL_X = VERTICAL ? 0 : -50;
    const FALL_Y = VERTICAL ? 100 : 50;
    const FALL_ROT = -10;
    const STACK_X = VERTICAL ? 0 : 50;
    const STACK_SS = VERTICAL ? 0.05 : 0.15;
    const DARK = 0.4;
    const Z_VALUES = [75, 50, 25];
    // Every duration × motion (0 under prefers-reduced-motion: a step sets its state at once). The gaps between the
    // reveal's phases (0.25 / 0.15 / 0.3 below) stay: under reduced motion the reveal is never played, only set to its end
    // (enter, reset) — and a timeline of zero length could not be sought back to its start (prepare)
    const DUR_FALL = 0.9 * motion;
    const DUR_SLIDE = 0.75 * motion;
    const EASE = 'power1.inOut';
    const DUR_BG = 0.7 * motion;
    const DUR_ARROW = 0.4 * motion;
    const DUR_LABEL = 0.5 * motion;
    const WK_STAG = 0.1 * motion;
    const WK_DUR = 0.4 * motion;
    const DUR_BLUE = 0.7 * motion;
    const DUR_RED = 0.45 * motion;
    const DUR_AWHITE = 0.6 * motion;
    const DUR_GRAD = 0.6 * motion;
    const DUR_DOTCOL = 0.3 * motion;
    const DUR_CARDSWRAP = 0.5 * motion;
    const DUR_DOT = 0.25 * motion; // a dot lights up
    const DUR_TAIL = 0.2 * motion;
    const WHITE_END_GAP = 5; // px: the white line stops short of the arrow head's tip
    const REV_SPEED = 5; // the reveal reversed when the section slides away
    const REVEAL_SPEED = 1.7; // the reveal played when the section appears (the card steps keep ×1)
    const theme = getComputedStyle(document.documentElement);
    const TEXT = theme.getPropertyValue('--theme-text').trim() || '#fdfcfc';
    const PAGE_BG = theme.getPropertyValue('--theme-page-bg').trim() || '#000';

    const maxState = cards.length - 1;

    // The blocks the reveal shows
    const labelKulbit = root.querySelector<HTMLElement>('[data-process-label="kulbit"]');
    const labelTraditional = root.querySelector<HTMLElement>('[data-process-label="traditional"]');
    const weeks = [...root.querySelectorAll<HTMLElement>('[data-process-week]')];

    // The cards: the order of the stack is fixed by the DOM; an overlay darkens a card in the stack
    const overlays = cards.map((card, i) => {
      card.style.transformOrigin = '50% 50%';
      card.style.zIndex = String(Z_VALUES[i] ?? 25);
      let overlay = card.querySelector<HTMLElement>(':scope > [data-process-overlay]');
      if (!overlay) {
        overlay = document.createElement('div');
        overlay.setAttribute('data-process-overlay', '');
        Object.assign(overlay.style, {
          position: 'absolute',
          inset: '0',
          background: PAGE_BG,
          opacity: '0',
          borderRadius: getComputedStyle(card).borderRadius,
          pointerEvents: 'none',
          zIndex: '10',
        });
        card.appendChild(overlay);
      }
      return overlay;
    });

    // ===== The active SVG diagram (the one with the lines, visible on this breakpoint) =====
    const diagrams = [...root.querySelectorAll<SVGSVGElement>('svg')].filter((s) => s.querySelector('[data-kulbit-svg-line]'));
    const hasWidth = (s: SVGSVGElement) => s.getBoundingClientRect().width > 1;
    const svg = diagrams.find((s) => hasWidth(s) && s.parentElement?.offsetParent != null) ?? diagrams.find(hasWidth) ?? null;

    const cleanSVG = () => {
      if (!svg) return;
      svg.querySelectorAll('clipPath').forEach((clip) => {
        if (clip.id.startsWith('wpClip')) clip.remove();
      });
      svg.querySelectorAll('[id^="wpW"]').forEach((el) => el.remove());
    };
    cleanSVG(); // leftovers of a previous build

    let bg: SVGPathElement | null = null;
    let blue: SVGPathElement | null = null;
    let red: SVGPathElement | null = null;
    let tail: SVGElement | null = null;
    let dotRings: SVGCircleElement[] = [];
    let arrowParts: SVGPathElement[] = [];
    let arrowNums: number[] = [];
    let greyStroke: string | null = null;
    let greyHead: string | null = null;
    let W = 0;
    let H = 0;
    let bgRect: SVGRectElement | null = null;
    let blueLen = 0;
    let redLen = 0;
    const arrowRects: Record<number, { rect: SVGRectElement; x0: number; x1: number }> = {};
    const whiteClones: Record<number, { el: SVGPathElement; len: number }> = {};
    const dotByN = (n: number) => dotRings.find((d) => d.getAttribute('data-kulbit-svg-dot') === String(n)) ?? null;
    // The white inner circle follows its ring in the markup
    const innerOf = (ring: SVGCircleElement) => ring.nextElementSibling;
    const arrowGroup = (n: number) => {
      const parts = arrowParts.filter((el) => el.getAttribute('data-kulbit-svg-arrow') === String(n));
      const part = (name: string) => parts.find((el) => el.getAttribute('data-kulbit-svg-part') === name) ?? null;
      return { line: part('line'), head: part('head'), fill: part('fill') };
    };

    if (svg) {
      const viewBox = (svg.getAttribute('viewBox') || '0 0 0 0').split(' ');
      W = parseFloat(viewBox[2]);
      H = parseFloat(viewBox[3]);
      const lines = [...svg.querySelectorAll<SVGPathElement>('[data-kulbit-svg-line]')];
      const byLine = (value: string) => lines.find((el) => el.getAttribute('data-kulbit-svg-line') === value) ?? null;
      bg = byLine('bg');
      blue = byLine('blue');
      red = byLine('red');
      tail = svg.querySelector<SVGElement>('[data-kulbit-svg-tail]');
      dotRings = [...svg.querySelectorAll<SVGCircleElement>('[data-kulbit-svg-dot]')];
      arrowParts = [...svg.querySelectorAll<SVGPathElement>('[data-kulbit-svg-arrow]')];
      arrowNums = [...new Set(arrowParts.map((el) => Number(el.getAttribute('data-kulbit-svg-arrow'))))].sort((a, b) => a - b);

      // The greys are read before our sets (fromTo tweens reverse to them after a breakpoint change)
      const dot1 = dotByN(1);
      const head1 = arrowGroup(1).head;
      greyStroke = dot1 ? getComputedStyle(dot1).stroke : null;
      greyHead = head1 ? getComputedStyle(head1).fill : null;

      const makeClip = (id: string, x0: number) => {
        const clip = document.createElementNS(NS, 'clipPath');
        clip.setAttribute('id', id);
        clip.setAttribute('clipPathUnits', 'userSpaceOnUse');
        const rect = document.createElementNS(NS, 'rect');
        rect.setAttribute('x', '0');
        rect.setAttribute('y', '0');
        rect.setAttribute('width', String(x0));
        rect.setAttribute('height', String(H));
        clip.appendChild(rect);
        svg.appendChild(clip);
        return rect;
      };

      // Hidden at the start
      arrowNums.forEach((n) => {
        const { fill } = arrowGroup(n);
        if (fill) gsap.set(fill, { autoAlpha: 0 });
      });
      if (tail) gsap.set(tail, { autoAlpha: 0 });
      dotRings.forEach((ring) => {
        [ring, innerOf(ring)].forEach((el) => el && gsap.set(el, { autoAlpha: 0 }));
      });
      [blue, red].forEach((el) => el && gsap.set(el, { autoAlpha: 0 }));

      if (bg) {
        bgRect = makeClip('wpClipBg', 0);
        bg.setAttribute('clip-path', 'url(#wpClipBg)');
      }

      arrowNums.forEach((n) => {
        const { line, head } = arrowGroup(n);
        if (!line) return;
        const box = line.getBBox();
        const headBox = head ? head.getBBox() : null;
        const x0 = Math.floor(box.x);
        const x1 = Math.ceil(Math.max(box.x + box.width, headBox ? headBox.x + headBox.width : 0)) + 2;
        const rect = makeClip(`wpClipArrow${n}`, x0);
        line.setAttribute('clip-path', `url(#wpClipArrow${n})`);
        if (head) head.setAttribute('clip-path', `url(#wpClipArrow${n})`);
        gsap.set([line, head].filter(Boolean), { autoAlpha: 1 });
        arrowRects[n] = { rect, x0, x1 };
      });

      blueLen = blue ? blue.getTotalLength() : 0;
      redLen = red ? red.getTotalLength() : 0;

      // The white clones of the arrows (arrow 1 in the reveal, the others on the steps), all undrawn at the start
      arrowNums.forEach((n) => {
        const { line } = arrowGroup(n);
        if (!line) return;
        const clone = line.cloneNode(true) as SVGPathElement;
        clone.setAttribute('id', `wpW${n}`);
        clone.removeAttribute('data-kulbit-svg-arrow');
        clone.removeAttribute('data-kulbit-svg-part');
        clone.removeAttribute('clip-path');
        clone.style.stroke = TEXT;
        clone.style.strokeWidth = '2';
        clone.style.fill = 'none';
        line.after(clone);
        const len = clone.getTotalLength();
        gsap.set(clone, { strokeDasharray: len, strokeDashoffset: len });
        whiteClones[n] = { el: clone, len };
      });
    }

    // The HTML blocks hidden at the start; the cards stacked under the first one. The cards by opacity, not autoAlpha
    // (the source's): hidden, they stay in the accessibility tree and their headings keep their text (the dev
    // toolbar's audit reads innerText); nothing in them is focusable or hoverable
    const htmlEls = [labelKulbit, labelTraditional, ...weeks].filter((el): el is HTMLElement => !!el);
    if (htmlEls.length) gsap.set(htmlEls, { autoAlpha: 0, y: 40 });
    gsap.set(cardsWrapper, { opacity: 0, y: 40 });

    let state = 0;

    // A card's vector for the state s: rank < 0 fell, 0 active (centre), ≥ 1 in the stack
    const cardVars = (i: number, s: number) => {
      const rank = i - s;
      if (rank < 0) {
        return { card: { xPercent: FALL_X, yPercent: FALL_Y, scale: 1, rotation: FALL_ROT, opacity: 0 }, overlay: { opacity: 0 } };
      }
      if (rank === 0) return { card: { xPercent: 0, yPercent: 0, scale: 1, rotation: 0, opacity: 1 }, overlay: { opacity: 0 } };
      return {
        card: { xPercent: STACK_X * rank, yPercent: 0, scale: 1 - STACK_SS * rank, rotation: 0, opacity: 1 },
        overlay: { opacity: DARK * rank },
      };
    };
    // The reveal's start: every card reset (yPercent too) → the first one in the centre, the others under it
    const resetCardsToStart = () => {
      cards.forEach((card, i) => {
        gsap.set(card, { xPercent: 0, yPercent: 0, scale: 1, rotation: 0, opacity: 1 });
        gsap.set(overlays[i], { opacity: 0 });
      });
    };
    resetCardsToStart();

    // The SVG of the steps (arrows 2+, dots 3+): the instant state for the state s
    const setStepSVGInstant = (s: number) => {
      arrowNums.forEach((n) => {
        if (n < 2) return; // arrow 1 belongs to the reveal
        const drawn = n <= s + 1;
        const clone = whiteClones[n];
        const { fill, head } = arrowGroup(n);
        if (clone) gsap.set(clone.el, { strokeDashoffset: drawn ? WHITE_END_GAP : clone.len });
        if (fill) gsap.set(fill, { autoAlpha: drawn ? 1 : 0 });
        if (head && greyHead) gsap.set(head, { fill: drawn ? TEXT : greyHead });
      });
      // The last dot (the red end, «Traditional») stays grey
      dotRings.forEach((ring) => {
        const n = Number(ring.getAttribute('data-kulbit-svg-dot'));
        if (n < 3 || n >= dotRings.length || !greyStroke) return;
        gsap.set(ring, { stroke: n <= s + 2 ? TEXT : greyStroke });
      });
    };
    setStepSVGInstant(0);

    // The full instant state (the cards + the whole SVG) for the state s: reset (restore / jump)
    const setStateInstant = (s: number) => {
      cards.forEach((card, i) => {
        const vars = cardVars(i, s);
        gsap.set(card, vars.card);
        gsap.set(overlays[i], vars.overlay);
      });
      setStepSVGInstant(s);
      state = s;
    };

    // ===== REVEAL timeline (played on enter, reversed on collapse) =====
    const revealTL = gsap.timeline({
      paused: true,
      onComplete: () => {
        app.isAnimating = false;
      },
    });
    if (svg && bgRect) {
      revealTL.fromTo(bgRect, { attr: { width: 0 } }, { attr: { width: W }, duration: DUR_BG, ease: 'none' }, 0);
      dotRings.forEach((ring) => {
        const at = (parseFloat(ring.getAttribute('cx') ?? '0') / W) * DUR_BG;
        [ring, innerOf(ring)].forEach((el) => {
          if (el) revealTL.to(el, { autoAlpha: 1, duration: DUR_DOT, ease: 'power1.out' }, at);
        });
      });
      if (tail) revealTL.to(tail, { autoAlpha: 1, duration: DUR_TAIL, ease: 'power1.out' }, DUR_BG);
      arrowNums.forEach((n, i) => {
        const arrow = arrowRects[n];
        if (arrow) {
          revealTL.fromTo(
            arrow.rect,
            { attr: { width: arrow.x0 } },
            { attr: { width: arrow.x1 }, duration: DUR_ARROW, ease: 'none' },
            DUR_BG + i * DUR_ARROW,
          );
        }
      });
    }
    const afterArrows = svg ? DUR_BG + arrowNums.length * DUR_ARROW : 0.2;
    if (labelKulbit) revealTL.to(labelKulbit, { autoAlpha: 1, y: 0, duration: DUR_LABEL, ease: 'power2.out' }, afterArrows);
    const weeksStart = afterArrows + 0.25;
    if (weeks.length) {
      revealTL.to(weeks, { autoAlpha: 1, y: 0, duration: WK_DUR, ease: 'power2.out', stagger: WK_STAG }, weeksStart);
    }
    const weeksEnd = weeks.length ? weeksStart + (weeks.length - 1) * WK_STAG + WK_DUR : afterArrows;

    const phase = weeksEnd + 0.15;
    const whiteEnd = phase + DUR_AWHITE;
    const redStart = phase + DUR_BLUE;
    const redEnd = redStart + DUR_RED;

    if (blue && blueLen) {
      revealTL.fromTo(
        blue,
        { autoAlpha: 1, strokeDasharray: blueLen, strokeDashoffset: blueLen },
        { strokeDashoffset: 0, duration: DUR_BLUE, ease: 'none' },
        phase,
      );
    }
    if (red && redLen) {
      revealTL.fromTo(
        red,
        { autoAlpha: 1, strokeDasharray: redLen, strokeDashoffset: redLen },
        { strokeDashoffset: 0, duration: DUR_RED, ease: 'none' },
        redStart,
      );
    }

    const arrow1 = arrowGroup(1);
    const white1 = whiteClones[1];
    if (white1) {
      revealTL.fromTo(
        white1.el,
        { strokeDashoffset: white1.len },
        { strokeDashoffset: WHITE_END_GAP, duration: DUR_AWHITE, ease: 'power1.inOut' },
        phase,
      );
    }
    if (arrow1.fill) revealTL.to(arrow1.fill, { autoAlpha: 1, duration: DUR_GRAD, ease: 'power1.out' }, phase);
    if (arrow1.head && greyHead) {
      revealTL.fromTo(
        arrow1.head,
        { fill: greyHead },
        { fill: TEXT, duration: DUR_AWHITE * 0.55, ease: 'power1.inOut' },
        phase + DUR_AWHITE * 0.45,
      );
    }
    const dot1 = dotByN(1);
    const dot2 = dotByN(2);
    if (dot1 && greyStroke) {
      revealTL.fromTo(dot1, { stroke: greyStroke }, { stroke: TEXT, duration: DUR_DOTCOL, ease: 'power1.out' }, phase);
    }
    if (dot2 && greyStroke) {
      revealTL.fromTo(dot2, { stroke: greyStroke }, { stroke: TEXT, duration: DUR_DOTCOL, ease: 'power1.out' }, whiteEnd);
    }

    revealTL.fromTo(
      cardsWrapper,
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: DUR_CARDSWRAP, ease: 'power2.out' },
      whiteEnd,
    );
    const slideAt = whiteEnd + 0.3;
    cards.forEach((card, i) => {
      if (i === 0) return;
      revealTL.fromTo(
        card,
        { xPercent: 0, yPercent: 0, scale: 1, rotation: 0, opacity: 1 },
        { xPercent: STACK_X * i, scale: 1 - STACK_SS * i, duration: DUR_SLIDE, ease: EASE },
        slideAt,
      );
      revealTL.fromTo(overlays[i], { opacity: 0 }, { opacity: DARK * i, duration: DUR_SLIDE, ease: EASE }, slideAt);
    });

    if (labelTraditional) {
      revealTL.to(labelTraditional, { autoAlpha: 1, y: 0, duration: DUR_LABEL, ease: 'power2.out' }, redEnd);
    }

    // ===== A card step + the SVG in sync =====
    let stepTL: gsap.core.Timeline | null = null;
    const stepTo = (to: number) => {
      const target = Math.max(0, Math.min(maxState, to));
      if (target === state) return false;
      const dir = target > state ? 1 : -1;
      const hi = Math.max(state, target);
      const arrowN = hi + 1; // 0 ↔ 1: arrow 2 / dot 3; 1 ↔ 2: arrow 3 / dot 4
      const dotN = hi + 2;
      stepTL?.kill();
      app.isAnimating = true;
      const tl = gsap.timeline({
        onComplete: () => {
          app.isAnimating = false;
        },
      });
      stepTL = tl;
      // The cards
      cards.forEach((card, i) => {
        const vars = cardVars(i, target);
        const duration = i - target < 0 ? DUR_FALL : DUR_SLIDE;
        tl.to(card, { duration, ease: EASE, ...vars.card }, 0);
        tl.to(overlays[i], { duration, ease: EASE, ...vars.overlay }, 0);
      });
      // The SVG in sync: the arrow is drawn together with the card taking the centre (DUR_SLIDE)
      if (svg) {
        const clone = whiteClones[arrowN];
        const { fill, head } = arrowGroup(arrowN);
        const dot = dotN < dotRings.length ? dotByN(dotN) : null; // the last dot stays grey
        if (dir > 0) {
          if (clone) tl.to(clone.el, { strokeDashoffset: WHITE_END_GAP, duration: DUR_SLIDE, ease: EASE }, 0);
          if (fill) tl.to(fill, { autoAlpha: 1, duration: DUR_SLIDE, ease: 'power1.out' }, 0);
          if (head && greyHead) tl.to(head, { fill: TEXT, duration: DUR_SLIDE * 0.55, ease: EASE }, DUR_SLIDE * 0.45);
          if (dot && greyStroke) tl.to(dot, { stroke: TEXT, duration: DUR_DOTCOL, ease: 'power1.out' }, DUR_SLIDE); // after the arrow
        } else {
          if (clone) tl.to(clone.el, { strokeDashoffset: clone.len, duration: DUR_SLIDE, ease: EASE }, 0);
          if (fill) tl.to(fill, { autoAlpha: 0, duration: DUR_SLIDE, ease: 'power1.out' }, 0);
          if (head && greyHead) tl.to(head, { fill: greyHead, duration: DUR_SLIDE * 0.55, ease: EASE }, 0);
          if (dot && greyStroke) tl.to(dot, { stroke: greyStroke, duration: DUR_DOTCOL, ease: 'power1.out' }, 0);
        }
      }
      state = target;
      return true;
    };

    const controller: SectionController = {
      get state() {
        return state;
      },
      // Sliding in from above: the hidden start
      prepare() {
        stepTL?.kill();
        state = 0;
        revealTL.timeScale(1).pause(0);
        resetCardsToStart();
        setStepSVGInstant(0);
      },
      // Covered: the reveal, faster; the gestures wait for its end. The lock only when the reveal really plays: a reveal
      // already at its end (a rebuild reset it there) would never complete and release it; under reduced motion the
      // end state comes at once and the next gesture is accepted. The cards are set explicitly: prepare() reset them,
      // and a zero-duration tween already at its end (reduced motion) does not render again
      enter() {
        if (reducedMotion || revealTL.progress() === 1) {
          revealTL.timeScale(1).progress(1).pause();
          setStateInstant(state);
          return;
        }
        app.isAnimating = true;
        revealTL.timeScale(REVEAL_SPEED).play();
      },
      // Sliding away downwards: the reveal reversed fast
      collapse() {
        revealTL.timeScale(REV_SPEED).reverse();
      },
      // Instant state (restore / jump; revealed from above = the last card)
      reset(toEnd) {
        stepTL?.kill();
        revealTL.timeScale(1).progress(1).pause();
        setStateInstant(toEnd ? maxState : 0);
      },
      // The breakpoint changes: the timelines, the clip paths and white clones, every inline state, the overlays
      dispose() {
        revealTL.kill();
        stepTL?.kill();
        cleanSVG();
        [bg, ...arrowParts].forEach((el) => el?.removeAttribute('clip-path'));
        const svgEls = [bg, blue, red, tail, ...arrowParts, ...dotRings, ...dotRings.map(innerOf)];
        const htmlBlocks = [labelKulbit, labelTraditional, ...weeks, cardsWrapper];
        gsap.set([...svgEls, ...htmlBlocks].filter(Boolean), { clearProps: 'all' });
        cards.forEach((card, i) => {
          gsap.set(card, { clearProps: 'all' });
          card.style.zIndex = '';
          card.style.transformOrigin = '';
          overlays[i].remove();
        });
      },
      step(dir) {
        const next = Math.max(0, Math.min(maxState, state + dir));
        if (next === state) return false; // the edge: the engine moves to the neighbouring section
        return stepTo(next);
      },
    };
    section.controller = controller;
  });
</script>
