---
/**
 * WorkingProcessIntro — the screen between Our Services and the working process, built from the Webflow build
 * (kulbit-gsap export, the section with «.flex-h-v-v.is-working-process-screen»); values 1:1 from its CSS
 * (1rem = 16px on the 1920 / 744 / 390 frames = our fluid scale).
 *
 * The full progress line, the label (written by scramble when the section enters the screen, data-kulbit-scramble),
 * the statement (typed letter by letter, data-kulbit-typewriter) and the pilot button (Button «second», the hover
 * border from the cursor: data-kulbit-border). No steps of its own: one gesture moves to the next section.
 */
import Button from '@/components/ui/Button.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale).workingProcessIntro;
---

<section class="section padding-64/48/24" data-kulbit-section>
  <div class="container">
    <div class="flex-v spacing-48/48/24 text-style-uppercase">
      <div class="working-process-intro_progress" aria-hidden="true"></div>
      <div class="working-process-intro_head flex-h/v/v spacing-0/64/24">
        <h2 class="text-size-16/16/13" data-kulbit-scramble>{t.title}</h2>
        <div class="working-process-intro_body flex-v spacing-120/160/64">
          <div class="working-process-intro_lead">
            <p class="working-process-intro_statement text-size-32/28/23" data-kulbit-typewriter>
              {
                t.statement.map((part, i) => (
                  <Fragment>
                    {i > 0 && ' '}
                    {part.grey ? <span class="working-process-intro_grey">{part.text}</span> : part.text}
                  </Fragment>
                ))
              }
            </p>
          </div>
          {/* TODO: where «Start Your Pilot» leads (the same question as the hero's «Start Pilot») */}
          <Button variant="second" data-kulbit-border>{t.pilot}</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* .section: 4rem top and bottom (tablet 3, mobile 1.5) */
  .padding-64\/48\/24 {
    padding-block: var(--size-64);
  }
  /* .gap-48-32-24: the Webflow CSS keeps 48 on tablet */
  .spacing-48\/48\/24 {
    gap: var(--size-48);
  }
  .spacing-0\/64\/24 {
    gap: 0;
  }
  .spacing-120\/160\/64 {
    gap: var(--size-120);
  }

  /* Decima Mono 16 / 1.1, tracking 0.03em (mobile 13): .text-size-section-label */
  .text-size-16\/16\/13 {
    font-size: var(--size-16);
    line-height: 1.1;
    letter-spacing: 0.03em;
  }
  /* PP Monument Wide 32 / 1.3, tracking 0.03em (tablet 28, mobile 23): .text-size-section-h2 */
  .text-size-32\/28\/23 {
    font-family: var(--font-secondary);
    font-size: var(--size-32);
    line-height: 1.3;
    letter-spacing: 0.03em;
  }

  /* .section-progresbar: nothing fills it here, the line stays full */
  .working-process-intro_progress {
    flex: none;
    height: var(--size-2);
    background-color: var(--theme-text);
  }
  /* .flex-h-v-v.is-working-process-screen */
  .working-process-intro_head {
    position: relative;
    align-items: flex-start;
    justify-content: space-between;
  }
  /* .margin-left-auto: the tablet column pushes it to the right (the desktop row does it by space-between) */
  .working-process-intro_body {
    margin-left: auto;
  }
  /* .width-695-557-a */
  .working-process-intro_lead {
    width: calc(43.44rem * var(--fluid-scale)); /* 695 */
  }
  .working-process-intro_statement {
    text-align: justify;
  }
  .working-process-intro_grey {
    color: #404040;
  }

  @media (max-width: 991px) {
    .padding-64\/48\/24 {
      padding-block: var(--size-48);
    }
    .spacing-0\/64\/24 {
      gap: var(--size-64);
    }
    .spacing-120\/160\/64 {
      gap: var(--size-160);
    }
    .text-size-32\/28\/23 {
      font-size: var(--size-28);
    }
    .working-process-intro_head {
      align-items: stretch;
      justify-content: flex-start;
    }
    .working-process-intro_lead {
      width: calc(34.81rem * var(--fluid-scale)); /* 557 */
    }
  }

  @media (max-width: 479px) {
    .padding-64\/48\/24 {
      padding-block: var(--size-24);
    }
    .spacing-48\/48\/24 {
      gap: var(--size-24);
    }
    .spacing-0\/64\/24 {
      gap: var(--size-24);
    }
    .spacing-120\/160\/64 {
      gap: var(--size-64);
    }
    .text-size-16\/16\/13 {
      font-size: calc(0.81rem * var(--fluid-scale));
    }
    .text-size-32\/28\/23 {
      font-size: calc(1.44rem * var(--fluid-scale));
    }
    .working-process-intro_lead {
      width: auto;
    }
  }
</style>
