---
/**
 * Button — three variants (Figma component «Button», layout as in the Webflow build):
 *   outline  a play icon + label on black in a 2px --theme-frame frame: the header button; icon only on mobile
 *   arrow    a red label + the red arrow square in a row: the hero CTA; the square only at ≤ 991px
 *   second   a white label in two lines + the blue arrow square in a 2px --theme-frame frame (.button.is-second): the
 *            pilot button of the working process; the square turns red on hover
 *   second-footer  the same in the footer (.button.is-second-footer): the whole width with the square at the end
 *            at 991px and below, centred at 479px and below
 *   showreel the play icon + label of `outline` centred over a picture that fills the frame (.button.is-footer: the
 *            footer's «Explore» card, the whole width; the label only on tablet / desktop); the picture comes in the
 *            `media` slot
 *   solid    a white label on the --theme-surface fill, the whole width, no icon (Figma «Get in touch»: «Submit
 *            message»; the Close of its success block); hover / focus = the Figma filled-state look (a lighter fill
 *            and a 1px frame)
 * `href` → <a>, otherwise <button type="button">; every other attribute passes through. A hidden label stays the
 * accessible name. The variant is `variant`, not `type` (that is the button's own attribute). The label carries
 * `data-button-label` (src/scripts/form.ts writes «Sending…» there); `:disabled` (a form sending) takes no clicks.
 */
import type { HTMLAttributes } from 'astro/types';
import IconArrow from '@/assets/icons/arrow-pilot.svg';
import IconPlay from '@/assets/icons/play.svg';

type Variant = { variant: 'outline' | 'arrow' | 'second' | 'second-footer' | 'showreel' | 'solid' };
type Props = Variant & ((HTMLAttributes<'a'> & { href: string }) | (HTMLAttributes<'button'> & { href?: never }));

const { variant, href, class: className, type, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const buttonType = href ? undefined : ((type ?? 'button') as 'button' | 'submit' | 'reset');
const textSize = {
  outline: 'text-size-button',
  arrow: 'text-size-button-hero',
  second: 'text-size-button-second',
  'second-footer': 'text-size-button-second',
  showreel: 'text-size-button',
  solid: 'text-size-button-solid',
}[variant];
const withPlay = variant === 'outline' || variant === 'showreel';
const withArrow = variant === 'arrow' || variant === 'second' || variant === 'second-footer';
---

<Tag
  href={href}
  type={buttonType}
  class:list={['button', `type--${variant}`, textSize, className]}
  {...rest}
>
  {Astro.slots.has('media') && <span class="button_media"><slot name="media" /></span>}
  {withPlay && <IconPlay class="button_icon" aria-hidden="true" />}
  <span class="button_label" data-button-label><slot /></span>
  {withArrow && <IconArrow class="button_arrow" aria-hidden="true" data-button-arrow />}
</Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--theme-text);
    font-family: var(--font-secondary);
    font-weight: var(--font-weight-extra-bold);
    text-transform: uppercase;
    white-space: nowrap;
  }
  /* PP Monument Wide Black 16 / 1.15 (tablet 14): .text-size-button */
  .text-size-button {
    font-size: var(--size-16);
    line-height: 1.15;
  }
  /* PP Monument Wide Black 32, tracking 0.03em: .text-size-button-hero */
  .text-size-button-hero {
    font-size: var(--size-32);
    line-height: 1.15;
    letter-spacing: 0.03em;
  }
  /* PP Monument Wide Black 18 / 1.15 (mobile 16): .text-size-button.is-second */
  .text-size-button-second {
    font-size: calc(1.13rem * var(--fluid-scale));
    line-height: 1.15;
  }
  /* PP Monument Wide Black 18 / 1.15 (tablet 16, mobile 14): «Submit message» */
  .text-size-button-solid {
    font-size: var(--size-18);
    line-height: 1.15;
  }
  /* Disabled while a form sends or after it was sent (src/scripts/form.ts): no hover, no clicks, the look stays */
  .button:disabled {
    pointer-events: none;
  }

  /* ---------- outline: header ---------- */
  .button.type--outline {
    gap: var(--spacing-xs);
    width: calc(18.625rem * var(--fluid-scale)); /* 298 */
    height: var(--size-64);
    /* an inner outline, as in Webflow: it takes no space, the hover border (data-kulbit-border) draws on its line */
    outline: var(--border-width-md) solid var(--theme-frame);
    outline-offset: calc(var(--border-width-md) * -1);
    border-radius: var(--radius-sm); /* 9 */
    background-color: var(--theme-page-bg);
  }
  .button_icon {
    flex: none;
    width: var(--size-24);
    height: var(--size-24);
  }

  /* ---------- arrow: hero CTA ---------- */
  .button.type--arrow {
    gap: var(--spacing-md);
    color: var(--theme-text-brand);
    transition: color var(--transition-duration) var(--transition-easing);
  }
  /* the square is currentColor: red, blue on hover (kulbit-webflow setupHeroColors) */
  .button_arrow {
    flex: none;
    width: var(--size-56);
    height: var(--size-56);
    transition: color var(--transition-duration) var(--transition-easing);
  }
  .button.type--arrow:hover,
  .button.type--arrow:focus-visible {
    color: var(--theme-text);
  }
  .button.type--arrow:hover .button_arrow,
  .button.type--arrow:focus-visible .button_arrow {
    color: var(--theme-icon-secondary);
  }

  /* ---------- showreel: the footer's «Explore» card (.button.is-footer) ---------- */
  .button.type--showreel {
    position: relative;
    isolation: isolate;
    flex-direction: column;
    gap: var(--spacing-xs);
    width: 100%;
    height: calc(17rem * var(--fluid-scale)); /* 272 */
    padding: var(--size-20); /* .button: 1.25rem (tablet 1, mobile 0.75) */
    overflow: hidden;
    outline: var(--border-width-md) solid var(--theme-frame);
    outline-offset: calc(var(--border-width-md) * -1);
    border-radius: var(--radius-sm); /* 9 */
    background-color: var(--theme-page-bg);
  }
  /* The picture under the icon and the label (Webflow: the background image, cover) */
  .button_media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* ---------- second: the pilot button of the working process (.button.is-second); second-footer: the footer's
     (.button.is-second-footer), the same at desktop ---------- */
  .button.type--second,
  .button.type--second-footer {
    gap: var(--spacing-lg);
    align-self: flex-start;
    padding: var(--spacing-lg) var(--spacing-xl);
    outline: var(--border-width-md) solid var(--theme-frame);
    outline-offset: calc(var(--border-width-md) * -1);
    border-radius: var(--radius-sm); /* 9 */
    background-color: var(--theme-page-bg);
    color: var(--theme-icon-secondary); /* the arrow square (currentColor); the label keeps its white */
    transition: color var(--transition-duration) var(--transition-easing);
  }
  /* .width-140.is-second-button: the label wraps in 140 and keeps its white */
  .type--second .button_label,
  .type--second-footer .button_label {
    width: calc(8.75rem * var(--fluid-scale)); /* 140 */
    color: var(--theme-text);
    text-align: left;
    white-space: normal;
  }
  /* .icon-40-40-32 */
  .type--second .button_arrow,
  .type--second-footer .button_arrow {
    width: var(--size-40);
    height: var(--size-40);
  }
  /* the Webflow interaction «Second Button [Hover]»: the square blue → red */
  .button.type--second:hover,
  .button.type--second:focus-visible,
  .button.type--second-footer:hover,
  .button.type--second-footer:focus-visible {
    color: var(--theme-icon-brand);
  }

  /* ---------- solid: «Submit message» of the contact popup (and its Close) ---------- */
  .button.type--solid {
    width: 100%;
    padding: var(--spacing-lg) var(--spacing-xl);
    border-radius: var(--radius-sm); /* 9 */
    background-color: var(--theme-surface);
    /* the 1px frame of the hover state, inside (the focus outline of base.css stays free) */
    box-shadow: inset 0 0 0 var(--border-width-sm) transparent;
    transition:
      background-color var(--transition-duration) var(--transition-easing),
      box-shadow var(--transition-duration) var(--transition-easing);
  }
  /* Figma's filled state (#1a1a1a + a 1px #272727 frame) ≈ --theme-frame + --theme-border (1–2 levels apart) */
  .button.type--solid:hover,
  .button.type--solid:focus-visible {
    background-color: var(--theme-frame);
    box-shadow: inset 0 0 0 var(--border-width-sm) var(--theme-border);
  }

  @media (max-width: 991px) {
    .text-size-button {
      font-size: var(--size-14);
    }
    .text-size-button-solid {
      font-size: var(--size-16);
    }
    .button.type--outline {
      width: calc(12.9375rem * var(--fluid-scale)); /* 207 */
      height: var(--size-56);
    }
    .button.type--showreel {
      height: calc(17.63rem * var(--fluid-scale)); /* 282 */
      padding: var(--spacing-md);
    }
    .button.type--second-footer {
      justify-content: space-between;
      width: 100%;
    }
    /* the square only; the label stays the accessible name */
    .type--arrow .button_label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  @media (max-width: 479px) {
    .text-size-button-second {
      font-size: var(--size-16);
    }
    .text-size-button-solid {
      font-size: var(--size-14);
    }
    .button.type--solid {
      padding: var(--spacing-md) var(--spacing-xl);
      border-radius: var(--size-6);
    }
    .button.type--second {
      gap: var(--spacing-md);
      padding: var(--size-20) var(--size-28);
    }
    .type--second .button_arrow,
    .type--second-footer .button_arrow {
      width: var(--size-32);
      height: var(--size-32);
    }
    .button.type--second-footer {
      gap: var(--spacing-lg);
      justify-content: center;
      padding: var(--spacing-md) var(--spacing-xl);
    }
    /* .width-140-140-a: auto */
    .type--second-footer .button_label {
      width: auto;
    }
    .button.type--showreel {
      height: calc(11.25rem * var(--fluid-scale)); /* 180 */
      padding: var(--spacing-sm);
    }
    /* .button: 0.75rem around the 1rem icon (.icon-24-24-16) */
    .button.type--outline {
      width: calc(5.625rem * var(--fluid-scale)); /* 90 */
      height: var(--size-40);
    }
    .type--outline .button_icon {
      width: var(--size-16);
      height: var(--size-16);
    }
    /* the play icon only */
    .type--outline .button_label,
    .type--showreel .button_label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
