---
/**
 * Logo — the Kulbit logo linking home (the Webflow build: .logo — the header and .logo.is-footer — the footer). On the
 * home page it is the current page's own item and no link: <span aria-current="page"> (an <a> without href is flagged
 * by the dev toolbar's audit). The accessible name is sr-only text; the square turns red on hover / focus of a real link
 * (Webflow .logo: blue → red).
 *   size     150/150/125 (default, the header) · 108 (the footer, every breakpoint) · 125 (every breakpoint: the
 *            landscape popup, .logo.is-landscape-popup)
 *   element  a (default): the link home · span: the plain mark, aria-hidden, where a link has no use (the landscape
 *            popup blocks the whole site: a link home would lead back to it)
 * Every other attribute passes through.
 */
import type { HTMLAttributes } from 'astro/types';
import LogoMark from '@/assets/icons/logo.svg';
import { localePath, useTranslations } from '@/i18n';

type Props = Omit<HTMLAttributes<'a'>, 'href'> & {
  size?: '150/150/125' | '108' | '125';
  element?: 'a' | 'span';
};

const { size = '150/150/125', element = 'a', class: className, ...rest } = Astro.props;
const t = useTranslations(Astro.currentLocale).logo;
const home = localePath('/', Astro.currentLocale);
const isHome = Astro.url.pathname === home;
const isLink = element === 'a';
const Tag = isLink && !isHome ? 'a' : 'span';
---

<Tag
  class:list={['logo', { 'size--108': size === '108', 'size--125': size === '125' }, className]}
  href={isLink && !isHome ? home : undefined}
  aria-current={isLink && isHome ? 'page' : undefined}
  aria-hidden={isLink ? undefined : 'true'}
  {...rest}>
  <LogoMark aria-hidden="true" />
  {isLink && <span class="sr-only">{t.home}</span>}
</Tag>

<style>
  .logo {
    display: block;
    width: calc(9.38rem * var(--fluid-scale)); /* 150 */
    color: var(--theme-icon);
  }
  .logo.size--108 {
    width: calc(6.75rem * var(--fluid-scale));
  }
  .logo.size--125 {
    width: calc(7.81rem * var(--fluid-scale));
  }
  .logo svg {
    display: block;
    width: 100%;
    height: auto;
  }
  /* The square is fill="var(--theme-icon-secondary)" in the file (svgo turns its <rect> into a <path>, the variable
   * stays): the link re-assigns the variable, the shapes fade to the new fill */
  .logo :global(path) {
    transition: fill var(--transition-duration) var(--transition-easing);
  }
  .logo[href]:hover,
  .logo[href]:focus-visible {
    --theme-icon-secondary: var(--theme-icon-brand);
  }
  @media (max-width: 479px) {
    .logo {
      width: calc(7.81rem * var(--fluid-scale)); /* 125 */
    }
  }
</style>
