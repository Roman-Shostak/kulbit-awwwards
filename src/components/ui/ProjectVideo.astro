---
/**
 * ProjectVideo — the player of a project video (the Webflow build: .projects-video-wrapper and everything inside it,
 * values 1:1 from its CSS). The poster and the big start button; after the start the control bar: play / pause, the
 * current and the total time, the seek line with its fill and buffer, the volume (a vertical slider in a popup;
 * from 991px down a mute toggle) and fullscreen. The behaviour is src/scripts/kulbit/project-video.ts (a port of
 * kulbit-webflow 10-project-video.js on a native <video> instead of the Vimeo SDK).
 * Props: `id` (required, unique on the page: the root's id; the volume popup and the poster build theirs from it — stable
 * between builds, no random ids), `src` (1080p, above 991px) + `srcSmall` (720p, up to 991px) — like the hero; `poster` +
 * `alt` (astro:assets); `element` div | li. The root fills its box (100 % × 100 %): the caller sizes it with its own
 * class. The poster is lazy (the step engine starts the images of the current and the next section, ./video) and
 * describes the start button (aria-describedby: two players, the same «Play video»); `sizes` ≈ the box in the Projects
 * column (91–92vw). The video waits with preload="none" until its section is the next one
 * (src/scripts/kulbit/project-video.ts → warm). The volume button has both names: «Volume» (desktop: it opens the
 * slider) and «Mute» (≤ 991px: a mute toggle, aria-pressed) — each shown by its visibility utility.
 */
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { Picture } from 'astro:assets';
import { useTranslations } from '@/i18n';
import IconFullscreen from '@/assets/icons/fullscreen.svg';
import IconPause from '@/assets/icons/pause.svg';
import IconPlay from '@/assets/icons/play.svg';
import IconPlayTriangle from '@/assets/icons/play-triangle.svg';
import IconMute from '@/assets/icons/speaker-mute.svg';
import IconVolume from '@/assets/icons/speaker-unmute.svg';
import { av1Type } from '@/data/video';

interface Props extends HTMLAttributes<'div'> {
  /** Unique on the page: the root's id and the base of the popup's and the poster's ids */
  id: string;
  src: string;
  srcSmall: string;
  /** The AV1 copies of src / srcSmall (with sound), played first where the browser decodes AV1 */
  srcAv1?: string;
  srcSmallAv1?: string;
  poster: ImageMetadata;
  alt: string;
  element?: 'div' | 'li';
}

const { id, src, srcSmall, srcAv1, srcSmallAv1, poster, alt, element = 'div', class: className, ...rest } = Astro.props;
const Tag = element;
const t = useTranslations(Astro.currentLocale).projectVideo;
// aria-controls of the volume button and aria-describedby of the start button
const popupId = `${id}-volume`;
const posterId = `${id}-poster`;
---

<Tag id={id} class:list={['project-video', className]} data-kulbit-project-video="" {...rest}>
  <video class="project-video_video" playsinline preload="none">
    {srcSmallAv1 && <source src={srcSmallAv1} type={av1Type(720, true)} media="(max-width: 991px)" />}
    <source src={srcSmall} type="video/mp4" media="(max-width: 991px)" />
    {srcAv1 && <source src={srcAv1} type={av1Type(1080, true)} />}
    <source src={src} type="video/mp4" />
  </video>
  <div class="project-video_poster" data-kulbit-poster>
    <Picture
      id={posterId}
      src={poster}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      width={1750}
      sizes="92vw"
      alt={alt}
      loading="lazy"
      class="fill-box"
    />
  </div>
  <button class="project-video_start" type="button" aria-describedby={posterId} data-kulbit-play>
    <IconPlay class="project-video_glyph" aria-hidden="true" />
    <span class="sr-only">{t.start}</span>
  </button>

  <div class="project-video_controls" data-kulbit-controls>
    <button class="project-video_toggle" type="button" data-kulbit-toggle>
      <span class="project-video_toggle-icon icon--pause" data-kulbit-icon-pause>
        <IconPause class="project-video_glyph" aria-hidden="true" />
        <span class="sr-only">{t.pause}</span>
      </span>
      <span class="project-video_toggle-icon icon--play" data-kulbit-icon-play>
        <IconPlayTriangle class="project-video_glyph" aria-hidden="true" />
        <span class="sr-only">{t.play}</span>
      </span>
    </button>
    <div class="project-video_time text-size-player text-weight-700">
      <span data-kulbit-time-current>0:00</span>
      <div
        class="project-video_line"
        role="slider"
        tabindex="0"
        aria-label={t.seek}
        aria-valuemin="0"
        aria-valuemax="0"
        aria-valuenow="0"
        aria-valuetext="0:00"
        data-kulbit-seek
      >
        <div class="project-video_buffer" data-kulbit-buffer></div>
        <div class="project-video_fill" data-kulbit-seek-fill></div>
      </div>
      <span class="project-video_total" data-kulbit-time-total>0:00</span>
    </div>
    <div class="project-video_volume" data-kulbit-volume>
      <button class="project-video_icon" type="button" aria-expanded="false" aria-controls={popupId} data-kulbit-volume-button>
        <IconVolume class="project-video_glyph" data-kulbit-icon-volume aria-hidden="true" />
        <IconMute class="project-video_glyph glyph--mute" data-kulbit-icon-mute aria-hidden="true" />
        <span class="sr-only desktop-only">{t.volume}</span>
        <span class="sr-only desktop-hide">{t.mute}</span>
      </button>
      <div class="project-video_popup" id={popupId} data-kulbit-volume-popup>
        <div
          class="project-video_track"
          role="slider"
          tabindex="0"
          aria-label={t.volume}
          aria-orientation="vertical"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="100"
          data-kulbit-volume-track
        >
          <div class="project-video_level" data-kulbit-volume-fill><span class="project-video_knob"></span></div>
        </div>
      </div>
    </div>
    <button class="project-video_icon" type="button" data-kulbit-fullscreen>
      <IconFullscreen class="project-video_glyph" aria-hidden="true" />
      <span class="sr-only">{t.fullscreen}</span>
    </button>
  </div>
</Tag>

<style>
  .project-video {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }
  /* cover the box, as the source's cover maths did for the Vimeo iframe */
  .project-video_video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  /* fullscreen held upright: the whole 16:9 frame in the middle, black above and below — not the cover crop */
  @media (orientation: portrait) {
    .project-video:fullscreen .project-video_video,
    .project-video_video:fullscreen {
      object-fit: contain;
    }
  }
  .project-video_poster {
    position: absolute;
    inset: 0;
    z-index: 75;
  }
  .project-video_glyph {
    width: 100%;
    height: 100%;
  }

  /* ---------- The big start button (.projects-main-play-button) ---------- */
  .project-video_start {
    position: absolute;
    inset: 0;
    z-index: 100;
    width: var(--size-64);
    aspect-ratio: 1;
    margin: auto;
    color: var(--theme-text);
    transition: transform var(--transition-duration) var(--transition-easing);
  }
  /* TODO: not in the design (the Webflow build has only the pointer cursor) */
  .project-video_start:hover,
  .project-video_start:focus-visible {
    transform: scale(1.1);
  }

  /* ---------- Control bar (.projects-controls-wrapper): hidden until the start ---------- */
  /* No CSS transition (the script fades it): reset.css's reduced-motion 0.01 ms would otherwise transition its
     visibility and keep it unfocusable for a few frames when the start moves the focus in */
  .project-video_controls {
    position: absolute;
    inset: auto 0 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding: var(--spacing-md);
    background-image: var(--theme-player-shade);
    opacity: 0;
    visibility: hidden;
    transition-property: none;
  }
  /* the round play / pause (.projects-controls-toggle); the ring is an inset shadow, not an outline: focus keeps its own */
  .project-video_toggle {
    position: relative;
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--size-56);
    aspect-ratio: 1;
    border-radius: 50%;
    background-color: var(--theme-page-bg);
    box-shadow: inset 0 0 0 var(--border-width-sm) var(--theme-track);
    color: var(--theme-text);
  }
  .project-video_toggle-icon {
    display: block;
    width: var(--size-16);
    aspect-ratio: 1;
  }
  /* paused at the start: the play triangle shows, the pause bars wait */
  .project-video_toggle-icon.icon--pause {
    opacity: 0;
    visibility: hidden;
  }
  .project-video_toggle-icon.icon--play {
    position: absolute;
    inset: 0 0 0 calc(0.1rem * var(--fluid-scale));
    margin: auto;
  }

  /* ---------- Time + seek line (.projects-controls-time-wrapper) ---------- */
  .project-video_time {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: calc(0.63rem * var(--fluid-scale)); /* 10 */
  }
  /* Decima Mono Bold 16 / 1 (12 from tablet down) */
  .text-size-player {
    font-size: var(--size-16);
    line-height: 1;
  }
  .project-video_total {
    opacity: 0.55;
  }
  .project-video_line {
    position: relative;
    flex: 1;
    height: calc(0.38rem * var(--fluid-scale)); /* 6 */
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--theme-player-seek);
    cursor: pointer;
    touch-action: none;
  }
  .project-video_buffer {
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 25;
    width: 0;
    border-radius: var(--radius-md);
    background-color: var(--theme-track);
  }
  .project-video_fill {
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 50;
    width: 0;
    border-radius: var(--radius-md);
    background-color: var(--theme-icon-secondary);
  }

  /* ---------- Volume + fullscreen (.icon-32-24.is-controls) ---------- */
  .project-video_volume {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }
  .project-video_icon {
    position: relative;
    display: block;
    flex: none;
    width: var(--size-32);
    aspect-ratio: 1;
    color: var(--theme-text);
  }
  .project-video_toggle,
  .project-video_icon {
    transition: opacity var(--transition-duration) var(--transition-easing);
  }
  /* TODO: not in the design (the Webflow build has only the pointer cursor) */
  .project-video_toggle:hover,
  .project-video_toggle:focus-visible,
  .project-video_icon:hover,
  .project-video_icon:focus-visible {
    opacity: 0.7;
  }
  /* sound on at the start: the speaker shows, the crossed one waits over it */
  .project-video_glyph.glyph--mute {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
  }
  /* the vertical slider above the speaker (.projects-controls-volume-popup) */
  .project-video_popup {
    position: absolute;
    inset: auto auto var(--size-48);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: var(--size-48);
    height: calc(9.13rem * var(--fluid-scale)); /* 146 */
    padding-block: var(--spacing-sm);
    border-radius: var(--size-12);
    background-color: var(--theme-page-bg);
    box-shadow: inset 0 0 0 var(--border-width-sm) var(--theme-track);
    opacity: 0;
    visibility: hidden;
  }
  .project-video_track {
    display: flex;
    align-items: flex-end;
    align-self: stretch;
    justify-content: center;
    width: calc(0.38rem * var(--fluid-scale));
    border-radius: var(--radius-md);
    background-color: var(--theme-player-volume);
    cursor: pointer;
    touch-action: none;
  }
  .project-video_level {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: calc(0.38rem * var(--fluid-scale));
    height: 100%;
    border-radius: var(--radius-md);
    background-color: var(--theme-icon-secondary);
  }
  .project-video_knob {
    position: absolute;
    top: calc(-0.3rem * var(--fluid-scale));
    width: var(--size-12);
    aspect-ratio: 1;
    border-radius: 50%;
    background-color: var(--theme-icon-secondary);
  }

  @media (max-width: 991px) {
    .project-video_start {
      width: var(--size-48);
    }
    .project-video_controls {
      gap: var(--spacing-xs);
      padding: var(--spacing-xs);
    }
    .project-video_toggle {
      width: var(--size-32);
    }
    .project-video_toggle-icon {
      width: var(--size-12);
    }
    .text-size-player {
      font-size: var(--size-12);
    }
    .project-video_icon {
      width: var(--size-24);
    }
    .project-video_popup {
      height: calc(8rem * var(--fluid-scale)); /* 128 */
      padding-top: var(--spacing-xs);
    }
  }

  @media (max-width: 479px) {
    .project-video_start {
      width: var(--size-32);
    }
    .project-video_toggle {
      width: var(--size-24);
    }
    .project-video_toggle-icon {
      width: var(--size-8);
    }
  }
</style>

<script>
  import { setupProjectVideos } from '@/scripts/kulbit/project-video';

  setupProjectVideos();
</script>
