---
/**
 * /dev/components — every component the site uses, with every variant, on the page background
 * (the whole site is dark: Kulbit has no light or dark section variants). Maintained by hand: when a ui component, a variant or a section is added, add it
 * here in the matching block (rules: .claude/rules/astro-components.md → Dev pages).
 * The page compares its registry with src/components/ui/ and src/components/sections/ and shows
 * a red notice for anything not showcased yet, so a missing entry is never silent.
 * Dev-only route (astro.config.mjs → devPages): never built, never indexed.
 *
 * How to add:
 *   ui component  → import it, push its name to `showcasedUi`, add a <section class="dev_component">
 *                   with one <figure class="dev_variant"> per prop combination (type × size × element,
 *                   link vs button, with/without icon …), each on <div class="dev_stage">.
 *                   Components wider than ~20rem (buttons, tags, logos: white-space: nowrap) go into
 *                   <div class="dev_variants dev_variants--wide"> so they fit their stage.
 *                   The commented block below shows a Button with its variants, the first component
 *                   of every project.
 *   section       → import it, push its name to `showcasedSections`, render it inside
 *                   <div class="dev_section-frame"> in the "Sections" block (header inside
 *                   <div class="header">, footer inside <footer class="footer">).
 */
import { Picture } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import Checkbox from '@/components/ui/Checkbox.astro';
import Form from '@/components/ui/Form.astro';
import Input from '@/components/ui/Input.astro';
import Logo from '@/components/ui/Logo.astro';
import ProgressLine from '@/components/ui/ProgressLine.astro';
import ProjectVideo from '@/components/ui/ProjectVideo.astro';
import Square from '@/components/ui/Square.astro';
import Hero from '@/components/sections/Hero.astro';
import OurClients from '@/components/sections/OurClients.astro';
import Projects from '@/components/sections/Projects.astro';
import OurServices from '@/components/sections/OurServices.astro';
import IntroScreen from '@/components/sections/IntroScreen.astro';
import WorkingProcess from '@/components/sections/WorkingProcess.astro';
import TraditionalProduction from '@/components/sections/TraditionalProduction.astro';
import SectionNav from '@/components/sections/SectionNav.astro';
import LandscapePopup from '@/components/sections/LandscapePopup.astro';
import Preloader from '@/components/sections/Preloader.astro';
import SiteHeader from '@/components/sections/SiteHeader.astro';
import SiteFooter from '@/components/sections/SiteFooter.astro';
import ContactPopup from '@/components/sections/ContactPopup.astro';
import { useTranslations } from '@/i18n';
import { SUBJECTS } from '../../worker/validate';
import DevShell from './DevShell.astro';
import posterRushCore from '@/assets/projects/project-rush-core-poster.avif';
import footerShowreel from '@/assets/site-footer/footer-showreel.avif';

const t = useTranslations(Astro.currentLocale);
const tProjects = t.projects;
const tPopup = t.contactPopup;
const fileName = (path: string) => path.split('/').pop()!.replace(/\.astro$/, '');
const uiFiles = Object.keys(import.meta.glob('../components/ui/*.astro')).map(fileName);
const sectionFiles = Object.keys(import.meta.glob('../components/sections/*.astro')).map(fileName);

// Registry of what this page renders — keep in sync with the blocks below
const showcasedUi: string[] = ['Button', 'Square', 'ProgressLine', 'ProjectVideo', 'Logo', 'Input', 'Checkbox', 'Form'];
const showcasedSections: string[] = ['SiteHeader', 'Hero', 'OurClients', 'Projects', 'OurServices', 'IntroScreen', 'WorkingProcess', 'TraditionalProduction', 'SectionNav', 'LandscapePopup', 'Preloader', 'SiteFooter', 'ContactPopup'];

const missingUi = uiFiles.filter((name) => !showcasedUi.includes(name));
const missingSections = sectionFiles.filter((name) => !showcasedSections.includes(name));
const stale = [...showcasedUi.filter((n) => !uiFiles.includes(n)), ...showcasedSections.filter((n) => !sectionFiles.includes(n))];
---

<DevShell title="Components">
  <header class="dev_head">
    <h1>Components</h1>
    <p>
      Every component from <code>src/components/ui/</code> with all its variants, and every section from
      <code>src/components/sections/</code>. Each new component or variant is added to this page by hand;
      the notices below appear when a file is not showcased yet.
    </p>
    <div class="dev_status">
      <span>ui: {uiFiles.length} files / {showcasedUi.length} showcased</span>
      <span>sections: {sectionFiles.length} files / {showcasedSections.length} showcased</span>
    </div>
    <nav class="dev_toc" aria-label="Components">
      {showcasedUi.map((name) => <a href={`#ui-${name.toLowerCase()}`}>{name}</a>)}
      <a href="#sections">Sections</a>
    </nav>
  </header>

  {missingUi.length > 0 && (
    <p class="dev_warn">Not showcased yet (src/components/ui/): {missingUi.map((n) => <code>{n} </code>)} — add them to this page with every variant.</p>
  )}
  {missingSections.length > 0 && (
    <p class="dev_warn">Not showcased yet (src/components/sections/): {missingSections.map((n) => <code>{n} </code>)} — add them to the Sections block.</p>
  )}
  {stale.length > 0 && <p class="dev_warn">Listed here but the file is gone: {stale.map((n) => <code>{n} </code>)} — remove them from the registry.</p>}

  <h2 id="ui">UI components</h2>

  {showcasedUi.length === 0 && (
    <p class="dev_empty">No ui components yet. Build them from the inventory list (Button first), then import each one here, add its name to <code>showcasedUi</code> and render every variant.</p>
  )}

  <section class="dev_component" id="ui-button">
    <h3>Button</h3>
    <p class="dev_component-meta"><code>src/components/ui/Button.astro</code> — variant: outline | arrow | second | second-footer | showreel | solid; href → a, otherwise button[type=button]; solid: the whole width, the hover / focus = the Figma filled-state look, <code>:disabled</code> while a form sends (the label carries <code>data-button-label</code>). The labels hide on mobile (outline, showreel) and ≤ 991px (arrow) and stay the accessible name; second / second-footer: the square turns red on hover; second-footer: the whole width with the square at the end ≤ 991px, centred ≤ 479px; showreel: the picture comes in the <code>media</code> slot and fills the frame (the whole width).</p>
    <div class="dev_variants dev_variants--wide">
      <figure class="dev_variant">
        <div class="dev_stage"><Button variant="outline">Showreel</Button></div>
        <figcaption><code>&lt;Button variant="outline"&gt;</code> → button</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Button variant="outline" href="/">Showreel</Button></div>
        <figcaption><code>&lt;Button variant="outline" href="/"&gt;</code> → a</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Button variant="arrow">Start Your Pilot</Button></div>
        <figcaption><code>&lt;Button variant="arrow"&gt;</code> → button</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Button variant="arrow" href="/">Start Your Pilot</Button></div>
        <figcaption><code>&lt;Button variant="arrow" href="/"&gt;</code> → a</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Button variant="second">Start Your Pilot</Button></div>
        <figcaption><code>&lt;Button variant="second"&gt;</code> → button</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Button variant="second" href="/">Start Your Pilot</Button></div>
        <figcaption><code>&lt;Button variant="second" href="/"&gt;</code> → a</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Button variant="second-footer">Let’s discuss</Button></div>
        <figcaption><code>&lt;Button variant="second-footer"&gt;</code> → button</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage">
          <Button variant="showreel">
            <Picture slot="media" src={footerShowreel} formats={['avif', 'webp']} fallbackFormat="jpg" width={680} alt="" class="fill-box" />
            Showreel
          </Button>
        </div>
        <figcaption><code>&lt;Button variant="showreel"&gt;&lt;Picture slot="media" … /&gt;</code> → button</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Button variant="solid" type="submit">Submit message</Button></div>
        <figcaption><code>&lt;Button variant="solid" type="submit"&gt;</code> → button (the contact popup)</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Button variant="solid" disabled>Sending…</Button></div>
        <figcaption><code>&lt;Button variant="solid" disabled&gt;</code> → a form sending</figcaption>
      </figure>
    </div>
  </section>

  <section class="dev_component" id="ui-input">
    <h3>Input</h3>
    <p class="dev_component-meta"><code>src/components/ui/Input.astro</code> — the contact popup's text field: the label (a red asterisk when required), «[ placeholder ]» over the empty field (the brackets are decoration, gone once it has a value), the hairline (white on hover / focus). element: input (default) | textarea. Error (<code>aria-invalid="true"</code>): the label red, a red asterisk at the end of the line. Type into a field to see the filled state.</p>
    <div class="dev_variants dev_variants--wide">
      <figure class="dev_variant">
        <div class="dev_stage"><Input id="dev-input-name" label={tPopup.name.label} placeholder={tPopup.name.placeholder} autocomplete="off" /></div>
        <figcaption><code>&lt;Input id label placeholder&gt;</code> → input, empty</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Input id="dev-input-email" type="email" label={tPopup.email.label} placeholder={tPopup.email.placeholder} required autocomplete="off" /></div>
        <figcaption><code>&lt;Input type="email" required&gt;</code> → the asterisk</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Input id="dev-input-filled" label={tPopup.name.label} placeholder={tPopup.name.placeholder} value="Samuel Bow" autocomplete="off" /></div>
        <figcaption><code>&lt;Input value="…"&gt;</code> → filled (no brackets)</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Input id="dev-input-error" type="email" label={tPopup.email.label} placeholder={tPopup.email.placeholder} required aria-invalid="true" autocomplete="off" /></div>
        <figcaption><code>&lt;Input aria-invalid="true"&gt;</code> → error</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Input id="dev-input-message" element="textarea" label={tPopup.message.label} placeholder={tPopup.message.placeholder} /></div>
        <figcaption><code>&lt;Input element="textarea"&gt;</code> → the message</figcaption>
      </figure>
    </div>
  </section>

  <section class="dev_component" id="ui-checkbox">
    <h3>Checkbox</h3>
    <p class="dev_component-meta"><code>src/components/ui/Checkbox.astro</code> — a native checkbox with its label as the control. variant: box (default: the consent; not in Figma — the pills' frame, the blue square when checked) | pill (the subjects; checked = blue; at ≤ 479px an option of the mobile list). Hover = focus: the frame white. Error (<code>aria-invalid="true"</code>, box): red.</p>
    <div class="dev_variants dev_variants--wide">
      <figure class="dev_variant">
        <div class="dev_stage"><Checkbox>{tPopup.consent}</Checkbox></div>
        <figcaption><code>&lt;Checkbox&gt;</code> → box</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Checkbox checked>{tPopup.consent}</Checkbox></div>
        <figcaption><code>&lt;Checkbox checked&gt;</code></figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Checkbox aria-invalid="true">{tPopup.consent}</Checkbox></div>
        <figcaption><code>&lt;Checkbox aria-invalid="true"&gt;</code> → error</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Checkbox variant="pill">{tPopup.subjects.options['brand-videos']}</Checkbox></div>
        <figcaption><code>&lt;Checkbox variant="pill"&gt;</code></figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Checkbox variant="pill" checked>{tPopup.subjects.options.strategy}</Checkbox></div>
        <figcaption><code>&lt;Checkbox variant="pill" checked&gt;</code></figcaption>
      </figure>
    </div>
  </section>

  <section class="dev_component" id="ui-form">
    <h3>Form</h3>
    <p class="dev_component-meta"><code>src/components/ui/Form.astro</code> — the shell of every form: posts to the Worker (<code>worker/index.ts</code>, <code>POST /api/form</code>) through <code>src/scripts/form.ts</code>; hidden <code>form</code>/<code>locale</code>/<code>started</code> fields, a honeypot, the message (<code>form</code> dictionary, role="alert"), the success block (+ the <code>success</code> slot). Live: submit empty → <code>aria-invalid</code> + the message; a valid submission needs <code>pnpm worker</code> running (proxied from <code>/api</code>).</p>
    <div class="dev_variants dev_variants--wide">
      <figure class="dev_variant">
        <div class="dev_stage">
          <Form name="dev" class="flex-v spacing-lg">
            <Input id="dev-form-email" type="email" name="email" label={tPopup.email.label} placeholder={tPopup.email.placeholder} autocomplete="email" required />
            <ul class="flex-h wrap spacing-sm">
              {SUBJECTS.slice(0, 3).map((subject) => <li><Checkbox variant="pill" name="subject" value={subject}>{tPopup.subjects.options[subject]}</Checkbox></li>)}
            </ul>
            <Checkbox name="consent" required>{tPopup.consent}</Checkbox>
            <Button type="submit" variant="solid">{tPopup.submit}</Button>
          </Form>
        </div>
        <figcaption>live · <code>&lt;Form name="dev"&gt;</code></figcaption>
      </figure>
    </div>
  </section>

  <section class="dev_component" id="ui-logo">
    <h3>Logo</h3>
    <p class="dev_component-meta"><code>src/components/ui/Logo.astro</code> — the logo linking home (on the home page: a span with aria-current="page", no link); the square turns red on hover of a real link. size: 150/150/125 (default, the header) | 108 (the footer) | 125 (every breakpoint: the landscape popup); element: a (default) | span (the plain mark, aria-hidden: the landscape popup).</p>
    <div class="dev_variants">
      <figure class="dev_variant">
        <div class="dev_stage"><Logo /></div>
        <figcaption><code>&lt;Logo /&gt;</code> → a, 150/150/125</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Logo size="108" /></div>
        <figcaption><code>&lt;Logo size="108" /&gt;</code></figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Logo size="125" /></div>
        <figcaption><code>&lt;Logo size="125" /&gt;</code></figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Logo element="span" size="125" /></div>
        <figcaption><code>&lt;Logo element="span" size="125" /&gt;</code> → span, aria-hidden</figcaption>
      </figure>
    </div>
  </section>

  <section class="dev_component" id="ui-square">
    <h3>Square</h3>
    <p class="dev_component-meta"><code>src/components/ui/Square.astro</code> — the decorative square, turns a quarter on hover; aria-hidden. size: 30/24/24 (default) | 30/24/16 | 24/24/16 | 12, color: blue (default) | red. The caller positions it with its own class.</p>
    <div class="dev_variants">
      <figure class="dev_variant">
        <div class="dev_stage"><Square /></div>
        <figcaption><code>&lt;Square class="…"&gt;</code> → span, 30/24/24 blue</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Square size="30/24/16" color="red" /></div>
        <figcaption><code>&lt;Square size="30/24/16" color="red"&gt;</code></figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Square size="24/24/16" /></div>
        <figcaption><code>&lt;Square size="24/24/16"&gt;</code></figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Square size="12" /></div>
        <figcaption><code>&lt;Square size="12"&gt;</code></figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><Square size="12" color="red" /></div>
        <figcaption><code>&lt;Square size="12" color="red"&gt;</code></figcaption>
      </figure>
    </div>
  </section>

  <section class="dev_component" id="ui-progressline">
    <h3>ProgressLine</h3>
    <p class="dev_component-meta"><code>src/components/ui/ProgressLine.astro</code> — the progress line of a section (Webflow .section-progresbar): the 2px track and the fill the section's script drives ([data-progress-fill], src/scripts/kulbit/progress-line.ts); aria-hidden. start: 0 (default) | third | sixth | full (no fill: the intro screens); a section sets another start width per breakpoint with <code>--progress-start</code> on its own class.</p>
    <div class="dev_variants dev_variants--wide">
      <figure class="dev_variant">
        <div class="dev_stage"><ProgressLine /></div>
        <figcaption><code>&lt;ProgressLine /&gt;</code> → empty (TraditionalProduction)</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><ProgressLine start="third" /></div>
        <figcaption><code>&lt;ProgressLine start="third" /&gt;</code> (OurClients)</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><ProgressLine start="sixth" /></div>
        <figcaption><code>&lt;ProgressLine start="sixth" /&gt;</code> (OurServices)</figcaption>
      </figure>
      <figure class="dev_variant">
        <div class="dev_stage"><ProgressLine start="full" /></div>
        <figcaption><code>&lt;ProgressLine start="full" /&gt;</code> (IntroScreen)</figcaption>
      </figure>
    </div>
  </section>

  <section class="dev_component" id="ui-projectvideo">
    <h3>ProjectVideo</h3>
    <p class="dev_component-meta"><code>src/components/ui/ProjectVideo.astro</code> — the project video player: poster + start button, then play / pause, time, seek with buffer, volume (a vertical slider; ≤ 991px a mute toggle), fullscreen. id (unique on the page: the root's id and the base of its popup's and poster's ids), src (1080p) + srcSmall (720p, ≤ 991px), poster + alt; element: div | li (li in Projects). Fills its box: the caller sizes it.</p>
    <div class="dev_variants dev_variants--wide">
      <figure class="dev_variant">
        <div class="dev_stage">
          <div class="dev_player">
            <ProjectVideo id="dev-project-video" src="/video/project-rush-core-1080.mp4" srcSmall="/video/project-rush-core-720.mp4" poster={posterRushCore} alt={tProjects.posters[0]} />
          </div>
        </div>
        <figcaption><code>&lt;ProjectVideo id src srcSmall poster alt&gt;</code> → div (16:9 box of this page)</figcaption>
      </figure>
    </div>
  </section>

  {/*
    Example block — the Button of a project with its variants:

    import Button from '@/components/ui/Button.astro';   ← in the frontmatter, and 'Button' in showcasedUi

    <section class="dev_component" id="ui-button">
      <h3>Button</h3>
      <p class="dev_component-meta"><code>src/components/ui/Button.astro</code> — href → a, otherwise button[type=button]; every other attribute passes through.</p>
      <div class="dev_variants dev_variants--wide">
        <figure class="dev_variant">
          <div class="dev_stage"><Button href="/">Link button</Button></div>
          <figcaption><code>&lt;Button href="/"&gt;</code> → a</figcaption>
        </figure>
        <figure class="dev_variant">
          <div class="dev_stage"><Button data-popup="callback">Action button</Button></div>
          <figcaption><code>&lt;Button data-popup="callback"&gt;</code> → button</figcaption>
        </figure>
        <figure class="dev_variant">
          <div class="dev_stage"><Button type="submit">Submit</Button></div>
          <figcaption><code>&lt;Button type="submit"&gt;</code></figcaption>
        </figure>
      </div>
    </section>
  */}

  {/*
    Example block for a component with prop variants (type × size), e.g. a Card from the inventory:

    const cardTypes = ['default', 'brand'] as const;   ← in the frontmatter
    const cardSizes = ['md', 'lg', 'xl'] as const;

    <section class="dev_component" id="ui-card">
      <h3>Card</h3>
      <p class="dev_component-meta"><code>src/components/ui/Card.astro</code> — type: default | brand, size: md | lg | xl, element: div | li | article.</p>
      <div class="dev_variants">
        {cardTypes.map((type) => cardSizes.map((size) => (
          <figure class="dev_variant">
            <div class="dev_stage"><Card type={type} size={size}><p class="text-size-body-md">Card {type} / {size}</p></Card></div>
            <figcaption><code>&lt;Card type="{type}" size="{size}"&gt;</code></figcaption>
          </figure>
        )))}
      </div>
    </section>
  */}

  <h2 id="sections">Sections</h2>
  {showcasedSections.length === 0 && (
    <p class="dev_empty">No sections yet. When a section is built, import it, add its name to <code>showcasedSections</code> and render it here in a <code>dev_section-frame</code>.</p>
  )}
  <div class="dev_section-frame"><div class="dev_section-label">SiteHeader.astro</div><div class="header"><SiteHeader /></div></div>
  <div class="dev_section-frame"><div class="dev_section-label">Hero.astro (start state; the step runs on the home page)</div><Hero /></div>
  <div class="dev_section-frame"><div class="dev_section-label">OurClients.astro (set 1; the steps and the scramble run on the home page)</div><OurClients /></div>
  <div class="dev_section-frame"><div class="dev_section-label">Projects.astro (the first card; the swap steps and the scramble run on the home page)</div><Projects /></div>
  <div class="dev_section-frame"><div class="dev_section-label">OurServices.astro (the first card; the swap steps, the card videos and the scramble run on the home page)</div><OurServices /></div>
  <div class="dev_section-frame"><div class="dev_section-label">IntroScreen.astro — working process (the scramble and the typewriter run on the home page)</div><IntroScreen {...t.workingProcessIntro} /></div>
  <div class="dev_section-frame"><div class="dev_section-label">WorkingProcess.astro (the diagram drawn, the first card in front; the reveal and the card steps run on the home page)</div><WorkingProcess /></div>
  <div class="dev_section-frame"><div class="dev_section-label">IntroScreen.astro — traditional production (the label with its blue accent)</div><IntroScreen {...t.traditionalProductionIntro} /></div>
  <div class="dev_section-frame"><div class="dev_section-label">TraditionalProduction.astro (the natural state: every card, both radars drawn; the steps and the head scramble run on the home page)</div><TraditionalProduction /></div>
  <div class="dev_section-frame"><div class="dev_section-label">SectionNav.astro (the arrow on the right edge of the window slides the panel in — here too; the items are links to the screens' anchors, the jumps and the current mark work on the home page; the last button pauses the background videos)</div><SectionNav /></div>
  <div class="dev_section-frame"><div class="dev_section-label">LandscapePopup.astro (open: in the flow of this page; on the home page fixed over everything and hidden until a phone is held sideways)</div><LandscapePopup open /></div>
  <div class="dev_section-frame"><div class="dev_section-label">Preloader.astro (inline: its start state in the flow of this page; on the home page fixed over everything, it plays on every load)</div><Preloader inline /></div>
  <div class="dev_section-frame"><div class="dev_section-label">SiteFooter.astro (in the layout's footer; the step scroll of tablet / mobile runs on the home page)</div><footer class="footer"><SiteFooter /></footer></div>
  <div class="dev_section-frame">
    <div class="dev_section-label">ContactPopup.astro (a modal dialog: the button opens it — the same as every <code>data-popup="contact"</code> CTA; ✕, Esc or a click outside the panel closes it)</div>
    <div class="dev_stage"><Button variant="solid" data-popup="contact">Open «Get in touch»</Button></div>
    <ContactPopup />
  </div>
</DevShell>
