---
/**
 * BaseLayout — the single HTML shell for every page.
 *
 * Body structure (Webflow framework):
 *   <div class="wrapper">                 flex column, min-height 100dvh
 *     <div class="header-fixed">          fixed to the top; rendered only when slot="header" is used
 *       <header class="header">           padding/background come from .header in utilities.css —
 *                                         the header component starts directly with <div class="container">
 *     <main class="main">                 default slot — page sections go here
 *     <footer class="footer">             rendered only when slot="footer" is used; dark background,
 *                                         padding and inverse colours come from .footer in utilities.css
 *
 * Props:
 *   title, description  required — <title>, meta description, Open Graph, Twitter. No placeholders:
 *                       the page must not ship as "Home".
 *   lang                defaults to the page's language from its URL (`Astro.currentLocale`, src/i18n);
 *                       pass it only for a page whose text is in another language.
 *   ogImage             a path under public/, e.g. "/og/home.jpg" (generated by scripts/build-og.mjs);
 *                       it becomes an absolute URL from `site` in astro.config.mjs.
 *   schema              page-scoped Schema.org nodes, the WebPage's main entity and the breadcrumb
 *                       trail (see src/data/schema.ts). Every page emits one JSON-LD graph: the
 *                       site-wide nodes + this page's WebPage (+ BreadcrumbList) + `schema.nodes`.
 *                       Rules per page type: .claude/skills/seo/SKILL.md; check with `pnpm seo`.
 *   motion              loads src/scripts/motion.ts (Lenis, reveal on scroll, hiding header, hero
 *                       intro). Off by default: zero client-side JS.
 *   hidingHeader        loads only src/scripts/header.ts: the header hides on scroll down and returns
 *                       on scroll up, with an offset. Not needed together with `motion` (included there).
 *   steps               loads src/scripts/steps.ts (GSAP): no free scroll, one gesture = one step (the next
 *                       part of a section's timeline or the next section); `data-scenes` on <main>.
 *                       Replaces `motion` (Lenis would fight the lock): with both, only `steps` loads.
 *   noindex             adds <meta name="robots" content="noindex, nofollow"> (dev pages, thank-you pages).
 *
 * Languages (src/i18n): og:locale comes from the page's language; an indexable page gets
 * <link rel="alternate" hreflang> for every built language + x-default (the default language) as
 * soon as more than one language has a dictionary.
 *
 * `site` in astro.config.mjs is required for canonical, og:url, og:image and the schema graph:
 * in a static build `Astro.url` only carries the pathname, absolute URLs are built from `Astro.site`.
 * Favicons: public/favicon.svg (from the client) → `pnpm favicon` writes favicon.ico + apple-touch-icon.png.
 *
 * Client fonts: configure `fonts` in astro.config.mjs (Astro Fonts API), then add in <head>:
 *   import { Font, fontData } from 'astro:assets';
 *   <Font cssVariable="--font-primary-custom" />
 *   <Font cssVariable="--font-secondary-custom" />
 * WITHOUT `preload`: `<Font preload>` preloads every subset file (4 subsets × weights = 12 files
 * competing with the hero image for bandwidth; the local provider leaves `subset` empty, so a
 * `preload={[{ subset }]}` filter removes everything). Build the links from `fontData` instead —
 * the first file of every weight/style is the site language's subset (`primarySubset` in
 * astro.config.mjs puts it first), one file per weight:
 *   const preloadFonts = (cssVariable: keyof typeof fontData) => {
 *     const seen = new Set<string>();
 *     return fontData[cssVariable].filter(({ weight, style }) => !seen.has(`${weight}/${style}`) && seen.add(`${weight}/${style}`)).map((f) => f.src[0]?.url).filter((url): url is string => !!url);
 *   };
 *   {preloadFonts('--font-primary-custom').map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
 * Measured on a client site (Lighthouse mobile): 12 preloads → LCP 2.6 s, 4 → 2.2 s, none → FCP +0.3 s.
 */
import { execSync } from 'node:child_process';
import { pageNodes, siteNodes, type Breadcrumb, type PageSchema, type SchemaNode } from '@/data/schema';
import { site } from '@/data/site';
import { alternates, defaultLocale, localeMeta, localized, toLocale } from '@/i18n';
import '@/styles/global.css';

// Publication stamp — the HTML comment on top of every page: the build time (UTC) and the commit it was built from
// (GITHUB_SHA in Actions, `git rev-parse` locally, `local` without git). Shows which version is live.
const publishedAt = new Date().toISOString().slice(0, 16).replace('T', ' ') + ' UTC';
const commit = (() => {
  if (process.env.GITHUB_SHA) return process.env.GITHUB_SHA.slice(0, 7);
  try {
    return execSync('git rev-parse --short HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim();
  } catch {
    return 'local';
  }
})();

interface Props {
  title: string;
  description: string;
  lang?: string;
  ogImage?: string;
  schema?: { type?: PageSchema['type']; nodes?: SchemaNode[]; mainEntityId?: string; breadcrumbs?: Breadcrumb[] };
  motion?: boolean;
  hidingHeader?: boolean;
  steps?: boolean;
  noindex?: boolean;
}

const locale = toLocale(Astro.currentLocale);
const { title, description, lang = localeMeta[locale].lang, ogImage, schema, motion = false, hidingHeader = false, steps = false, noindex = false } = Astro.props;
const loadMotion = motion && !steps;
const siteName = localized(site.name, locale);
const skipLabel = { uk: 'Перейти до контенту', ru: 'Перейти к содержимому', en: 'Skip to content' }[lang] ?? 'Skip to content';
const ogImageUrl = ogImage && (Astro.site ? new URL(ogImage, Astro.site).href : ogImage);
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);
// hreflang: the same page in every built language + x-default (the default language); one language → none
const origin = Astro.site;
const languages = origin && !noindex ? alternates(Astro.url.pathname) : [];
const hreflang =
  origin && languages.length > 1
    ? [
        ...languages.map(({ lang, path }) => ({ hreflang: lang, href: new URL(path, origin).href })),
        ...languages
          .filter((language) => language.locale === defaultLocale)
          .map(({ path }) => ({ hreflang: 'x-default', href: new URL(path, origin).href })),
      ]
    : [];

const graph =
  Astro.site && canonical
    ? [
        ...(await siteNodes(Astro.site, locale)),
        ...pageNodes({ site: Astro.site, url: canonical, title, description, lang, type: schema?.type, ogImageUrl, mainEntityId: schema?.mainEntityId, breadcrumbs: schema?.breadcrumbs }),
        ...(schema?.nodes ?? []),
      ]
    : [];
// "<" is escaped so no text in the graph can close the script element
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replaceAll('<', '\\u003c');
---

<!doctype html>
<Fragment set:html={`<!-- Published: ${publishedAt} · commit ${commit} -->`} />
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical.href} />}
    {hreflang.map((link) => <link rel="alternate" {...link} />)}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    {siteName && <meta property="og:site_name" content={siteName} />}
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    {graph.length > 0 && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    {/* Step scroll: the lock (and CSS gated by it) applies before the first paint, only with JS */}
    {steps && <script is:inline>document.documentElement.dataset.steps = '';</script>}

    <!--
      Fluid scale: writes --viewport-width (clientWidth without scrollbar, capped at --max)
      onto <html>. tokens.css turns it into --fluid-scale = --viewport-width / --reference.
      Kept inline so the value exists before first paint.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var previous = null;

        function update() {
          var max = parseFloat(getComputedStyle(root).getPropertyValue('--max'));
          var width = root.clientWidth;
          var value = max && width >= max ? max : width;
          if (value === previous) return;
          previous = value;
          root.style.setProperty('--viewport-width', value);
        }

        update();
        document.addEventListener('DOMContentLoaded', update);
        window.addEventListener('load', update);
        window.addEventListener('resize', update);
        new ResizeObserver(function () {
          if (root.scrollHeight > root.clientHeight) update();
        }).observe(root);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <div class="wrapper">
      {
        Astro.slots.has('header') && (
          <div class="header-fixed">
            <header class="header">
              <slot name="header" />
            </header>
          </div>
        )
      }
      <main class="main" id="main" tabindex="-1" data-scenes={steps ? '' : undefined}>
        <slot />
      </main>
      {
        Astro.slots.has('footer') && (
          <footer class="footer">
            <slot name="footer" />
          </footer>
        )
      }
    </div>
    {
      steps && (
        <script>
          import '@/scripts/steps';
        </script>
      )
    }
    {
      loadMotion && (
        <script>
          import '@/scripts/motion';
        </script>
      )
    }
    {
      hidingHeader && !loadMotion && (
        <script>
          import '@/scripts/header';
        </script>
      )
    }
  </body>
</html>
