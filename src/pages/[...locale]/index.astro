---
import SiteHeader from '@/components/sections/SiteHeader.astro';
import Hero from '@/components/sections/Hero.astro';
import OurClients from '@/components/sections/OurClients.astro';
import Projects from '@/components/sections/Projects.astro';
import OurServices from '@/components/sections/OurServices.astro';
import WorkingProcessIntro from '@/components/sections/WorkingProcessIntro.astro';
import { localeStaticPaths, useTranslations } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';

export const getStaticPaths = localeStaticPaths;

const t = useTranslations(Astro.currentLocale).pages.home;
---

<BaseLayout title={t.title} description={t.description} steps>
  <SiteHeader slot="header" />
  <Hero />
  <OurClients />
  <Projects />
  <OurServices />
  <WorkingProcessIntro />
</BaseLayout>
