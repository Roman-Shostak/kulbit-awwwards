---
import SiteHeader from '@/components/sections/SiteHeader.astro';
import Hero from '@/components/sections/Hero.astro';
import OurClients from '@/components/sections/OurClients.astro';
import Projects from '@/components/sections/Projects.astro';
import OurServices from '@/components/sections/OurServices.astro';
import IntroScreen from '@/components/sections/IntroScreen.astro';
import WorkingProcess from '@/components/sections/WorkingProcess.astro';
import TraditionalProduction from '@/components/sections/TraditionalProduction.astro';
import SectionNav from '@/components/sections/SectionNav.astro';
import LandscapePopup from '@/components/sections/LandscapePopup.astro';
import Preloader from '@/components/sections/Preloader.astro';
import SiteFooter from '@/components/sections/SiteFooter.astro';
import ContactPopup from '@/components/sections/ContactPopup.astro';
import { localeStaticPaths, useTranslations } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';

export const getStaticPaths = localeStaticPaths;

const t = useTranslations(Astro.currentLocale);
---

<BaseLayout
  title={t.pages.home.title}
  description={t.pages.home.description}
  ogImage="/og/og-home.jpg"
  ogImageAlt={t.pages.home.ogImageAlt}
  steps>
  <SiteHeader slot="header" />
  <SectionNav slot="header" />
  <Preloader slot="header" />
  <LandscapePopup slot="header" />
  <Hero />
  <OurClients />
  <Projects />
  <OurServices />
  <IntroScreen id="working-process-intro" {...t.workingProcessIntro} />
  <WorkingProcess />
  <IntroScreen id="traditional-production-intro" {...t.traditionalProductionIntro} />
  <TraditionalProduction />
  <ContactPopup />
  <SiteFooter slot="footer" />
</BaseLayout>
