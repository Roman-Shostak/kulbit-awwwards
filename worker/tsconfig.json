{
  // The Worker runs on workerd, not in a browser: no DOM lib, the runtime types come from
  // worker/worker-configuration.d.ts generated by `pnpm worker:types` (part of `pnpm check`).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts"]
}
